<!-- pages/profile/index.wxml -->
<view class="container">
  <!-- 用户信息卡片 -->
  <view class="user-card">
    <button class="user-avatar-wrapper" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar" bindtap="checkLoginForAvatar" hover-class="none">
      <image 
        class="user-avatar" 
        src="{{userInfo.avatarUrl || '/assets/images/default-avatar.png'}}" 
        mode="aspectFill"
      ></image>
      <view class="avatar-edit">
        <text>编辑</text>
      </view>
    </button>
    <view class="user-info">
      <view class="user-name-row">
        <text class="user-name">{{userInfo.nickname || '未登录'}}</text>
        <view class="vip-badge" wx:if="{{userInfo.isVip}}">
          <text>VIP</text>
        </view>
      </view>
      <text class="user-phone" wx:if="{{userInfo.nickname}}">{{userInfo.phone || ''}}</text>
      <text class="login-tip" wx:else bindtap="goToLogin">点击登录</text>
    </view>
  </view>

  <!-- 宠物列表 -->
  <view class="pet-section">
    <view class="section-header">
      <text class="section-title">我的毛孩子 🐾</text>
      <text class="section-action" bindtap="goToAddPet">🐾 迎接新成员</text>
    </view>
    
    <scroll-view class="pet-list" scroll-x>
      <view 
        class="pet-card {{item.petId === petId ? 'active' : ''}}" 
        wx:for="{{petList}}" 
        wx:key="petId"
        bindtap="selectPet" 
        data-id="{{item.petId}}"
      >
        <image 
          class="pet-avatar" 
          src="{{item.avatarUrl || '/assets/images/default-pet.png'}}" 
          mode="aspectFill"
        ></image>
        <text class="pet-name">{{item.name}}</text>
        <text class="pet-breed" wx:if="{{item.breed}}">{{item.breed}}</text>
        <view class="current-badge" wx:if="{{item.petId === petId}}">
          <text>当前</text>
        </view>
				<view class="pet-edit-btn" bindtap="editPet" data-id="{{item.petId}}">
          <text>✏️</text>
        </view>
      </view>
      
      <view class="pet-card add-card" bindtap="goToAddPet">
        <view class="add-icon">🐾</view>
        <text class="add-text">迎接新成员</text>
      </view>
    </scroll-view>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-section">
		<view class="menu-item" bindtap="goToRecordList">
      <view class="menu-left">
        <text class="menu-icon">🐾</text>
        <text class="menu-text">我们的回忆</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>

    <view class="menu-item" bindtap="goToSettings">
      <view class="menu-left">
        <text class="menu-icon">⚙️</text>
        <text class="menu-text">设置</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
    
    <view class="menu-item" bindtap="goToHelp">
      <view class="menu-left">
        <text class="menu-icon">❓</text>
        <text class="menu-text">帮助与反馈</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
    
    <view class="menu-item" bindtap="goToAbout">
      <view class="menu-left">
        <text class="menu-icon">ℹ️</text>
        <text class="menu-text">关于我们</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- 会员入口 -->
  <!-- <view class="vip-section" wx:if="{{!userInfo.isVip}}">
    <view class="vip-banner" bindtap="goToVip">
      <view class="vip-left">
        <text class="vip-title">开通会员</text>
        <text class="vip-desc">解锁更多高级功能</text>
      </view>
      <view class="vip-right">
        <text class="vip-btn">立即开通</text>
      </view>
    </view>
  </view> -->

  <!-- 退出登录 -->
  <view class="logout-section" wx:if="{{userInfo}}">
    <button class="logout-btn" bindtap="logout">退出登录</button>
  </view>

  <!-- 版本信息 -->
  <view class="version-info">
    <text>V1.0.0</text>
  </view>

  <!-- 底部导航栏占位 -->
  <view class="tab-bar-placeholder"></view>
</view>
