/* pages/profile/feedback/feedback.wxss */

.feedback-container {
  min-height: 100vh;
  padding: 28rpx 28rpx 48rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at 86% 4%, rgba(132, 183, 108, 0.18) 0, rgba(132, 183, 108, 0) 170rpx),
    linear-gradient(180deg, #FFF3E4 0%, #FFF9F2 46%, #F6EFE5 100%);
  color: #4B3B32;
}

.feedback-header {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 260rpx;
  padding: 34rpx 30rpx;
  border-radius: 26rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #F8A75B 0%, #EF815D 56%, #D96F53 100%);
  box-shadow: 0 18rpx 38rpx rgba(217, 111, 83, 0.22);
}

.feedback-header::before {
  content: "";
  position: absolute;
  left: -58rpx;
  bottom: -64rpx;
  width: 210rpx;
  height: 210rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.14);
}

.feedback-header::after {
  content: "";
  position: absolute;
  right: -46rpx;
  top: -44rpx;
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
}

.header-copy {
  position: relative;
  z-index: 1;
  display: flex;
  flex: 1;
  flex-direction: column;
  padding-right: 18rpx;
}

.header-kicker {
  align-self: flex-start;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.23);
  color: #FFFDF8;
  font-size: 23rpx;
  font-weight: 600;
}

.header-title {
  margin-top: 18rpx;
  color: #FFFFFF;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.3;
}

.header-subtitle {
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.86);
  font-size: 24rpx;
  line-height: 1.55;
}

.header-pet {
  position: relative;
  z-index: 1;
  width: 128rpx;
  height: 128rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 44rpx;
  background: rgba(255, 255, 255, 0.2);
  box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, 0.28);
  flex-shrink: 0;
}

.header-pet-face {
  font-size: 72rpx;
}

.form-section {
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(240, 223, 200, 0.82);
  box-shadow: 0 10rpx 28rpx rgba(146, 103, 67, 0.09);
}

.form-item {
  display: flex;
  flex-direction: column;
}

.form-label {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-bottom: 18rpx;
  color: #4B3B32;
  font-size: 29rpx;
  font-weight: 700;
}

.label-text {
  margin-right: 8rpx;
}

.label-required {
  color: #E16E4D;
  font-size: 32rpx;
  font-weight: 700;
}

.label-optional {
  margin-left: 6rpx;
  color: #A48B79;
  font-size: 23rpx;
  font-weight: 400;
}

.feedback-textarea,
.contact-input {
  width: 100%;
  box-sizing: border-box;
  border: 1rpx solid #EEDFCC;
  border-radius: 18rpx;
  background: #FFF9F2;
  color: #4B3B32;
  font-size: 27rpx;
  box-shadow: inset 0 2rpx 8rpx rgba(146, 103, 67, 0.04);
}

.feedback-textarea {
  min-height: 224rpx;
  padding: 20rpx;
  line-height: 1.65;
}

.contact-input {
  height: 88rpx;
  padding: 0 20rpx;
}

.feedback-textarea::placeholder,
.contact-input::placeholder {
  color: #BBA99D;
}

.char-count {
  display: flex;
  justify-content: flex-end;
  margin-top: 10rpx;
  color: #A48B79;
  font-size: 23rpx;
}

.image-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  margin-top: 16rpx;
}

.image-upload-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  width: 100%;
  aspect-ratio: 1;
  border: 2rpx dashed #E8CDB3;
  border-radius: 18rpx;
  background: #FFF7EC;
  transition: all 0.25s ease;
}

.image-upload-btn:active {
  border-color: #E58A55;
  background: #FFF0E4;
}

.upload-icon {
  width: 54rpx;
  height: 54rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  background: #FFE6D4;
  color: #D87545;
  font-size: 42rpx;
  font-weight: 500;
  line-height: 1;
}

.icon-text {
  display: block;
  line-height: 1;
  transform: translateY(-2rpx);
}

.upload-text {
  margin-top: 10rpx;
  color: #A47D62;
  font-size: 22rpx;
  font-weight: 600;
}

.image-item {
  position: relative;
  width: 100%;
  aspect-ratio: 1;
  border-radius: 18rpx;
  overflow: hidden;
  background: #F2E7DA;
  box-shadow: 0 6rpx 16rpx rgba(146, 103, 67, 0.12);
}

.image-preview {
  width: 100%;
  height: 100%;
}

.upload-status {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(75, 59, 50, 0.54);
  border-radius: 18rpx;
}

.status-text {
  color: #FFFFFF;
  font-size: 23rpx;
  font-weight: 600;
}

.delete-btn {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 42rpx;
  height: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(75, 59, 50, 0.68);
  box-shadow: 0 4rpx 10rpx rgba(75, 59, 50, 0.22);
}

.delete-icon {
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1;
}

.submit-section {
  margin-top: 32rpx;
  padding: 0;
  border: none;
  background: transparent;
  box-shadow: none;
}

.submit-btn {
  width: 100%;
  height: 92rpx;
  border: none;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #F7A45A 0%, #E87852 100%);
  color: #FFFFFF;
  font-size: 31rpx;
  font-weight: 700;
  line-height: 92rpx;
  box-shadow: 0 12rpx 24rpx rgba(232, 120, 82, 0.25);
}

.submit-btn::after {
  border: none;
}

.submit-btn:active:not(.disabled) {
  opacity: 0.9;
}

.submit-btn.disabled {
  background: #E5DCD2;
  color: #AFA296;
  box-shadow: none;
  opacity: 1;
}

.help-text {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 22rpx;
}

.help-item {
  display: flex;
  align-items: center;
  padding: 20rpx 22rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.82);
  border: 1rpx solid rgba(240, 223, 200, 0.78);
}

.help-icon {
  width: 42rpx;
  height: 42rpx;
  margin-right: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  background: #FFF0DE;
  font-size: 23rpx;
  flex-shrink: 0;
}

.help-content {
  flex: 1;
  color: #705A4B;
  font-size: 25rpx;
  line-height: 1.5;
}

.submit-btn {    flex: 1;
	height: 88rpx;
	line-height: 88rpx;
	display: flex;
	align-items: center;
	justify-content: center;
	padding: 0;
}