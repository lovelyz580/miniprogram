/* pages/profile/settings/settings.wxss */

.settings-container {
  min-height: 100vh;
  padding: 28rpx 28rpx 48rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at 12% 6%, rgba(255, 194, 122, 0.28) 0, rgba(255, 194, 122, 0) 170rpx),
    linear-gradient(180deg, #FFF4E7 0%, #FFF9F1 48%, #F7F1E8 100%);
  color: #4B3B32;
}

.settings-hero {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 248rpx;
  padding: 34rpx 30rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #F9A65A 0%, #F07F58 58%, #D56A50 100%);
  box-shadow: 0 18rpx 38rpx rgba(213, 106, 80, 0.22);
}

.settings-hero::after {
  content: "";
  position: absolute;
  right: -60rpx;
  bottom: -90rpx;
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.16);
}

.hero-copy {
  position: relative;
  z-index: 1;
  display: flex;
  flex: 1;
  flex-direction: column;
  padding-right: 20rpx;
}

.hero-kicker {
  align-self: flex-start;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.22);
  color: #FFFDF8;
  font-size: 23rpx;
  font-weight: 600;
}

.hero-title {
  margin-top: 18rpx;
  color: #FFFFFF;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.28;
}

.hero-desc {
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.86);
  font-size: 24rpx;
  line-height: 1.55;
}

.hero-paw {
  position: relative;
  z-index: 1;
  width: 128rpx;
  height: 128rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 44rpx;
  background: rgba(255, 255, 255, 0.2);
  box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, 0.28);
  flex-shrink: 0;
}

.paw-main {
  font-size: 70rpx;
}

.paw-dot {
  position: absolute;
  color: rgba(255, 255, 255, 0.62);
  font-size: 18rpx;
}

.paw-dot-one {
  top: 18rpx;
  right: 26rpx;
}

.paw-dot-two {
  left: 22rpx;
  bottom: 22rpx;
}

.settings-section {
  margin-top: 28rpx;
  border-radius: 22rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 10rpx 28rpx rgba(146, 103, 67, 0.1);
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 28rpx 22rpx;
  border-bottom: 1rpx solid #F2E5D8;
  background: linear-gradient(180deg, #FFFFFF 0%, #FFF8EF 100%);
}

.section-title {
  color: #4B3B32;
  font-size: 30rpx;
  font-weight: 700;
}

.section-subtitle {
  margin-top: 6rpx;
  color: #9B7B63;
  font-size: 23rpx;
}

.section-badge {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #EAF6EA;
  color: #5B9B67;
  font-size: 22rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.permission-item {
  display: flex;
  align-items: center;
  padding: 24rpx 26rpx;
  border-bottom: 1rpx solid #F4E9DD;
  transition: background-color 0.25s ease, transform 0.25s ease;
}

.permission-item:last-child {
  border-bottom: none;
}

.permission-item:active {
  background-color: #FFF5EA;
}

.permission-icon {
  width: 72rpx;
  height: 72rpx;
  margin-right: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  font-size: 34rpx;
  flex-shrink: 0;
}

.permission-icon.album {
  background: #FFF0D7;
}

.permission-icon.camera {
  background: #FFE5DD;
}

.permission-icon.location {
  background: #EAF5E8;
}

.permission-icon.record {
  background: #F7EADF;
}

.permission-icon.contact {
  background: #F0E9DD;
}

.permission-info {
  flex: 1;
  min-width: 0;
}

.permission-name {
  color: #4B3B32;
  font-size: 28rpx;
  font-weight: 700;
}

.permission-desc {
  margin-top: 7rpx;
  color: #9C8270;
  font-size: 23rpx;
  line-height: 1.4;
}

.permission-status {
  min-width: 92rpx;
  margin-left: 12rpx;
  margin-right: 16rpx;
  color: #A99B91;
  font-size: 23rpx;
  font-weight: 600;
  text-align: right;
  flex-shrink: 0;
}

.permission-status.authorized {
  color: #5B9B67;
}

.permission-btn {
  min-width: 104rpx;
  height: 58rpx;
  padding: 0 20rpx;
  border: 1rpx solid #F0B07E;
  border-radius: 999rpx;
  background: #FFF5EC;
  color: #D87545;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 56rpx;
  box-shadow: none;
}

.permission-btn::after {
  border: none;
}

.permission-btn.authorized {
  border-color: #78B684;
  background: linear-gradient(135deg, #83C48D 0%, #5FA86D 100%);
  color: #FFFFFF;
  box-shadow: 0 6rpx 14rpx rgba(95, 168, 109, 0.2);
}

.permission-btn:active {
  opacity: 0.82;
}

.tips-section {
  margin-top: 24rpx;
  border-radius: 22rpx;
  overflow: hidden;
  background: #FFFDF8;
  border: 1rpx solid #F0DFC8;
  box-shadow: 0 8rpx 24rpx rgba(146, 103, 67, 0.08);
}

.tips-content {
  position: relative;
  padding: 26rpx 28rpx 26rpx 34rpx;
}

.tips-content::before {
  content: "";
  position: absolute;
  top: 28rpx;
  left: 18rpx;
  width: 6rpx;
  height: 84rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #F9A65A 0%, #84B76C 100%);
}

.tips-title {
  color: #B76635;
  font-size: 28rpx;
  font-weight: 700;
}

.tips-text {
  margin-top: 12rpx;
  color: #7E6656;
  font-size: 24rpx;
  line-height: 1.65;
  white-space: pre-wrap;
}
