/* login.wxss */

/* 页面容器 */
.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFFFFF 0%, #FFFBF5 100%);
  position: relative;
  overflow: hidden;
}

/* 背景装饰 */
.bg-decoration {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
}

.deco-circle {
  position: absolute;
  border-radius: 50%;
  opacity: 0.1;
  background: linear-gradient(135deg, #FFB74D 0%, #FF8A65 100%);
}

.circle1 {
  width: 400rpx;
  height: 400rpx;
  top: -100rpx;
  right: -100rpx;
}

.circle2 {
  width: 300rpx;
  height: 300rpx;
  top: 300rpx;
  left: -150rpx;
}

.circle3 {
  width: 200rpx;
  height: 200rpx;
  bottom: 200rpx;
  right: -50rpx;
}

/* Logo区域 */
.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 160rpx;
}

.logo-wrapper {
  width: 200rpx;
  height: 200rpx;
  background-color: #FFFFFF;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 40rpx rgba(255, 138, 101, 0.15);
  margin-bottom: 40rpx;
}

.logo-image {
  width: 240rpx;
  height: 240rpx;
}

.app-name {
  font-size: 48rpx;
  font-weight: 700;
  color: #333333;
  margin-bottom: 16rpx;
}

.app-slogan {
  font-size: 28rpx;
  color: #999999;
}

/* 功能介绍 */
.features-section {
  padding: 60rpx 60rpx 40rpx;
}

.feature-item {
  display: flex;
  align-items: flex-start;
  padding: 30rpx 0;
}

.feature-icon {
  font-size: 56rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.feature-text {
  display: flex;
  flex-direction: column;
}

.feature-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 8rpx;
}

.feature-desc {
  font-size: 26rpx;
  color: #999999;
  line-height: 1.6;
}

/* 协议说明 */
.agreement-section {
  padding: 0 60rpx 40rpx;
}

.agreement-check {
  display: flex;
  align-items: flex-start;
}

.checkbox {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid #CCCCCC;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  margin-top: 4rpx;
  flex-shrink: 0;
}

.checkbox.checked {
  background-color: #FF8A65;
  border-color: #FF8A65;
  color: #FFFFFF;
  font-size: 24rpx;
}

.agreement-text {
  font-size: 24rpx;
  color: #666666;
  line-height: 1.6;
}

.link {
  color: #FF8A65;
}

/* 登录按钮 */
.login-section {
  padding: 0 60rpx;
}

.login-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  padding: 28rpx;
  background-color: #E6E6E6;
  border-radius: 48rpx;
  border: none;
}

.login-btn.active {
  background-color: #07C160;
}

.login-btn.active.hover {
  background-color: #06AD56;
}

.login-btn[disabled] {
  background-color: #E6E6E6;
}

.wechat-icon {
  width: 44rpx;
  height: 44rpx;
  margin-right: 16rpx;
}

.login-text {
  font-size: 32rpx;
  color: #FFFFFF;
  font-weight: 500;
}

/* 备选登录方式 */
.alternative-login {
  margin-top: 60rpx;
}

.divider {
  display: flex;
  align-items: center;
  margin-bottom: 40rpx;
}

.divider-line {
  flex: 1;
  height: 1rpx;
  background-color: #EEEEEE;
}

.divider-text {
  font-size: 24rpx;
  color: #999999;
  padding: 0 20rpx;
}

.alt-options {
  display: flex;
  justify-content: center;
}

.alt-option {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 40rpx;
}

.alt-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.alt-text {
  font-size: 24rpx;
  color: #666666;
}

/* 游客入口 */
.visitor-section {
  position: fixed;
  bottom: 60rpx;
  left: 0;
  right: 0;
  text-align: center;
  padding-bottom: env(safe-area-inset-bottom);
}

.visitor-btn {
  font-size: 26rpx;
  color: #999999;
  padding: 20rpx;
}

/* 弹窗样式 */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  visibility: hidden;
  opacity: 0;
  transition: all 0.3s ease;
}

.modal.show {
  visibility: visible;
  opacity: 1;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 90%;
  max-height: 70vh;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  border-bottom: 1rpx solid #FFF0E5;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.modal-close {
  font-size: 48rpx;
  color: #999999;
  font-weight: 300;
}

.modal-body {
  flex: 1;
  padding: 30rpx;
  max-height: 50vh;
}

.agreement-content {
  font-size: 28rpx;
  line-height: 2;
  color: #666666;
  white-space: pre-wrap;
}

/* 爪印记忆暖系主题强化 */
.container {
  background:
    radial-gradient(circle at 86% 8%, rgba(255, 194, 122, 0.26) 0, rgba(255, 194, 122, 0) 210rpx),
    radial-gradient(circle at 8% 46%, rgba(132, 183, 108, 0.14) 0, rgba(132, 183, 108, 0) 180rpx),
    linear-gradient(180deg, #FFF4E7 0%, #FFF9F1 52%, #F7F1E8 100%);
}

.deco-circle {
  background: linear-gradient(135deg, #F7A45A 0%, #E87852 100%);
  opacity: 0.12;
}

.logo-wrapper {
  border: 1rpx solid rgba(240, 223, 200, 0.82);
  border-radius: 56rpx;
  box-shadow: 0 18rpx 38rpx rgba(146, 103, 67, 0.12);
}

.app-name,
.feature-title,
.modal-title {
  color: #4B3B32;
}

.app-slogan,
.feature-desc,
.agreement-text,
.divider-text,
.agreement-content {
  color: #7E6656;
}

.features-section {
  margin: 48rpx 40rpx 28rpx;
  padding: 18rpx 26rpx;
  border: 1rpx solid rgba(240, 223, 200, 0.82);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.82);
  box-shadow: 0 10rpx 28rpx rgba(146, 103, 67, 0.08);
}

.feature-item {
  padding: 24rpx 0;
}

.checkbox.checked {
  background-color: #E87852;
  border-color: #E87852;
}

.link {
  color: #D87545;
  font-weight: 600;
}

.login-btn {
  border-radius: 999rpx;
}

.login-btn.active,
.login-btn.active.hover {
  background: linear-gradient(135deg, #73B77A 0%, #5FA86D 100%);
  box-shadow: 0 10rpx 24rpx rgba(95, 168, 109, 0.24);
}

.login-btn[disabled] {
  background-color: #E5DCD2;
}

.visitor-btn {
  color: #A47D62;
}

.modal-mask {
  background-color: rgba(75, 59, 50, 0.48);
}

.modal-content {
  border-radius: 28rpx;
  border: 1rpx solid rgba(240, 223, 200, 0.82);
  box-shadow: 0 18rpx 44rpx rgba(75, 59, 50, 0.16);
}
