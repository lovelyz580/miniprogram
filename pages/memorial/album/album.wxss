/* album.wxss */

/* 页面容器 */
.container {
  min-height: 100vh;
  background-color: #1A1A1A;
  color: #FFFFFF;
  padding-bottom: 40rpx;
}

/* 顶部标题 */
.header {
  position: relative;
  padding: 60rpx 30rpx 40rpx;
  background: linear-gradient(180deg, #2D2D2D 0%, #1A1A1A 100%);
}

.header-content {
  position: relative;
  z-index: 1;
}

.pet-info {
  display: flex;
  align-items: center;
}

.pet-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid #FFFFFF;
  margin-right: 24rpx;
}

.pet-details {
  display: flex;
  flex-direction: column;
}

.pet-name {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.pet-dates {
  font-size: 24rpx;
  color: #999999;
}

.header-bg {
  position: absolute;
  right: 30rpx;
  top: 30rpx;
  font-size: 100rpx;
  opacity: 0.3;
}

/* 纪念语 */
.memorial-message {
  padding: 40rpx 30rpx;
  text-align: center;
  border-bottom: 1rpx solid #333333;
}

.message-text {
  font-size: 28rpx;
  color: #CCCCCC;
  line-height: 1.8;
  font-style: italic;
}

/* 照片墙 */
.photos-section {
  padding: 30rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
}

.photo-count {
  font-size: 24rpx;
  color: #999999;
}

.photo-grid {
  display: flex;
  flex-wrap: wrap;
}

.photo-item {
  width: 220rpx;
  height: 220rpx;
  margin-right: 10rpx;
  margin-bottom: 10rpx;
  border-radius: 12rpx;
  overflow: hidden;
  position: relative;
}

.photo-item:nth-child(3n) {
  margin-right: 0;
}

.photo-image {
  width: 100%;
  height: 100%;
}

.photo-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 12rpx;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.7));
}

.photo-date {
  font-size: 20rpx;
  color: #FFFFFF;
}

.add-photo-btn {
  width: 220rpx;
  height: 220rpx;
  background-color: #2D2D2D;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #444444;
}

.add-icon {
  font-size: 64rpx;
  color: #666666;
  line-height: 1;
}

.add-text {
  font-size: 22rpx;
  color: #666666;
  margin-top: 8rpx;
}

/* 时间线 */
.timeline-section {
  padding: 30rpx;
}

.timeline {
  position: relative;
  padding-left: 40rpx;
}

.timeline::before {
  content: '';
  position: absolute;
  left: 8rpx;
  top: 0;
  bottom: 0;
  width: 2rpx;
  background-color: #333333;
}

.timeline-item {
  position: relative;
  padding-bottom: 40rpx;
}

.timeline-item:last-child {
  padding-bottom: 0;
}

.timeline-dot {
  position: absolute;
  left: -40rpx;
  top: 0;
  width: 18rpx;
  height: 18rpx;
  background-color: #666666;
  border-radius: 50%;
  border: 4rpx solid #1A1A1A;
}

.timeline-dot.first {
  background-color: #FFFFFF;
  width: 24rpx;
  height: 24rpx;
  left: -43rpx;
}

.timeline-content {
  display: flex;
  flex-direction: column;
}

.timeline-date {
  font-size: 22rpx;
  color: #999999;
  margin-bottom: 8rpx;
}

.timeline-title {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: 500;
}

.timeline-desc {
  font-size: 24rpx;
  color: #AAAAAA;
  margin-top: 4rpx;
}

/* 重要时刻 */
.milestones-section {
  padding: 30rpx;
}

.milestones-list {
  display: flex;
  flex-wrap: wrap;
}

.milestone-item {
  display: flex;
  align-items: center;
  width: 50%;
  padding: 20rpx 0;
}

.milestone-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.milestone-content {
  display: flex;
  flex-direction: column;
}

.milestone-name {
  font-size: 26rpx;
  color: #FFFFFF;
}

.milestone-date {
  font-size: 22rpx;
  color: #999999;
}

/* 操作区域 */
.actions-section {
  display: flex;
  padding: 30rpx;
  border-top: 1rpx solid #333333;
  border-bottom: 1rpx solid #333333;
}

.action-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx;
}

.action-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.action-text {
  font-size: 22rpx;
  color: #CCCCCC;
}

/* 思念墙 */
.memorial-wall {
  padding: 30rpx;
}

.more-btn {
  font-size: 24rpx;
  color: #3366CC;
}

.memories-list {
  margin-top: 20rpx;
}

.memory-item {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #333333;
}

.memory-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.memory-content {
  flex: 1;
}

.memory-header {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.memory-name {
  font-size: 26rpx;
  font-weight: 600;
  margin-right: 16rpx;
}

.memory-time {
  font-size: 22rpx;
  color: #999999;
}

.memory-text {
  font-size: 26rpx;
  color: #CCCCCC;
  line-height: 1.6;
}

.input-memory {
  margin-top: 20rpx;
  padding: 24rpx;
  background-color: #2D2D2D;
  border-radius: 12rpx;
}

.input-placeholder {
  font-size: 28rpx;
  color: #666666;
}

/* 弹窗 */
.picker-modal,
.memory-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  visibility: hidden;
  opacity: 0;
  transition: all 0.3s ease;
}

.picker-modal.show,
.memory-modal.show {
  visibility: visible;
  opacity: 1;
}

.picker-mask,
.memory-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.7);
}

.picker-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #2D2D2D;
  border-radius: 24rpx 24rpx 0 0;
  padding-bottom: env(safe-area-inset-bottom);
}

.picker-header {
  padding: 30rpx;
  text-align: center;
  border-bottom: 1rpx solid #444444;
}

.picker-title {
  font-size: 32rpx;
  font-weight: 600;
}

.picker-options {
  display: flex;
  padding: 30rpx;
}

.picker-option {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx;
  background-color: #3D3D3D;
  border-radius: 16rpx;
  margin: 0 10rpx;
}

.option-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.option-text {
  font-size: 26rpx;
  color: #FFFFFF;
}

.picker-cancel {
  padding: 30rpx;
  text-align: center;
  color: #999999;
  font-size: 30rpx;
  border-top: 1rpx solid #444444;
}

/* 思念输入弹窗 */
.memory-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #2D2D2D;
  border-radius: 24rpx 24rpx 0 0;
  padding: 30rpx;
  padding-bottom: calc(30rpx + env(safe-area-inset-bottom));
}

.memory-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.memory-cancel {
  font-size: 28rpx;
  color: #999999;
}

.memory-title {
  font-size: 32rpx;
  font-weight: 600;
}

.memory-submit {
  font-size: 28rpx;
  color: #666666;
}

.memory-submit.active {
  color: #3366CC;
}

.memory-input {
  width: 100%;
  min-height: 200rpx;
  padding: 20rpx;
  background-color: #3D3D3D;
  border-radius: 12rpx;
  font-size: 30rpx;
  line-height: 1.6;
  color: #FFFFFF;
}

.memory-footer {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
}

.memory-count {
  font-size: 24rpx;
  color: #999999;
}
