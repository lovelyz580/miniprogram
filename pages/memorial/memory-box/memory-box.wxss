/* memory-box.wxss */

/* 页面容器 */
.container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background-color: #F5F7FA;
}

/* 顶部标题 */
.header {
  padding: 40rpx 30rpx;
  background-color: #FFFFFF;
}

.header-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #333333;
  display: block;
  margin-bottom: 8rpx;
}

.header-desc {
  font-size: 26rpx;
  color: #999999;
}

/* 统计信息 */
.stats-section {
  display: flex;
  padding: 20rpx 30rpx;
}

.stat-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx;
  background-color: #FFFFFF;
  border-radius: 16rpx;
  margin-right: 20rpx;
}

.stat-card:last-child {
  margin-right: 0;
}

.stat-number {
  font-size: 48rpx;
  font-weight: 700;
  color: #3366CC;
}

.stat-label {
  font-size: 24rpx;
  color: #999999;
  margin-top: 8rpx;
}

/* 分类筛选 */
.category-section {
  padding: 20rpx 0;
  background-color: #FFFFFF;
  border-top: 1rpx solid #EEEEEE;
  border-bottom: 1rpx solid #EEEEEE;
}

.category-scroll {
  white-space: nowrap;
  padding: 0 20rpx;
}

.category-item {
  display: inline-flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background-color: #F5F7FA;
  border-radius: 32rpx;
  margin-right: 16rpx;
}

.category-item.active {
  background-color: #3366CC;
}

.category-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.category-name {
  font-size: 26rpx;
  color: #666666;
}

.category-item.active .category-name {
  color: #FFFFFF;
}

/* 纪念品列表 */
.item-list {
  flex: 1;
  height: calc(100vh - 400rpx);
  padding: 20rpx;
}

.item-card {
  display: flex;
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.item-media {
  width: 160rpx;
  height: 160rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.item-image {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.item-placeholder {
  width: 100%;
  height: 100%;
  background-color: #F5F7FA;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.placeholder-icon {
  font-size: 64rpx;
}

.item-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.item-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.category-tag {
  display: inline-block;
  padding: 4rpx 12rpx;
  background-color: #E6F0FF;
  color: #3366CC;
  font-size: 20rpx;
  border-radius: 8rpx;
}

.item-date {
  font-size: 22rpx;
  color: #999999;
}

.item-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 8rpx;
}

.item-desc {
  font-size: 24rpx;
  color: #666666;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.item-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}

.item-location {
  display: flex;
  align-items: center;
}

.location-icon {
  font-size: 22rpx;
  margin-right: 6rpx;
}

.location-text {
  font-size: 22rpx;
  color: #999999;
}

.item-actions {
  display: flex;
}

.action-btn {
  font-size: 24rpx;
  color: #3366CC;
  margin-left: 16rpx;
}

.action-btn.danger {
  color: #FF4D4F;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 60rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 36rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 28rpx;
  color: #999999;
  text-align: center;
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 30rpx;
  color: #3366CC;
  font-size: 28rpx;
}

/* 悬浮按钮 */
.fab-container {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  z-index: 100;
}

.fab-btn {
  width: 100rpx;
  height: 100rpx;
  background-color: #3366CC;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 20rpx rgba(51, 102, 204, 0.4);
}

.fab-icon {
  font-size: 56rpx;
  color: #FFFFFF;
  font-weight: 300;
}

/* 添加弹窗 */
.add-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  visibility: hidden;
  opacity: 0;
  transition: all 0.3s ease;
}

.add-modal.show {
  visibility: visible;
  opacity: 1;
}

.add-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
}

.add-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  max-height: 85vh;
  background-color: #FFFFFF;
  border-radius: 24rpx 24rpx 0 0;
  display: flex;
  flex-direction: column;
}

.add-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  border-bottom: 1rpx solid #EEEEEE;
}

.add-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.add-close {
  font-size: 48rpx;
  color: #999999;
  font-weight: 300;
}

.add-form {
  flex: 1;
  padding: 20rpx 30rpx;
  max-height: 60vh;
}

.form-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F5F7FA;
}

.form-item.vertical {
  flex-direction: column;
  align-items: flex-start;
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  width: 160rpx;
  font-size: 28rpx;
  color: #333333;
  flex-shrink: 0;
}

.required {
  color: #FF4D4F;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  text-align: right;
}

.form-input.placeholder,
.form-picker .placeholder {
  color: #CCCCCC;
}

/* 分类选择 */
.category-picker {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
}

.category-option {
  display: flex;
  align-items: center;
  padding: 12rpx 20rpx;
  background-color: #F5F7FA;
  border-radius: 12rpx;
  margin-right: 12rpx;
  margin-bottom: 12rpx;
}

.category-option.active {
  background-color: #E6F0FF;
}

.option-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.option-name {
  font-size: 24rpx;
  color: #666666;
}

.category-option.active .option-name {
  color: #3366CC;
}

/* 照片上传 */
.photo-upload {
  flex: 1;
  height: 180rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.upload-preview {
  width: 100%;
  height: 100%;
}

.upload-placeholder {
  width: 100%;
  height: 100%;
  background-color: #F5F7FA;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #DDDDDD;
}

.upload-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.upload-text {
  font-size: 24rpx;
  color: #999999;
}

/* 文本域 */
.form-textarea {
  width: 100%;
  min-height: 120rpx;
  padding: 16rpx;
  background-color: #F5F7FA;
  border-radius: 12rpx;
  font-size: 28rpx;
  margin-top: 12rpx;
}

/* 日期选择 */
.form-picker {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  font-size: 28rpx;
}

.picker-arrow {
  font-size: 32rpx;
  color: #CCCCCC;
  margin-left: 12rpx;
}

/* 底部保存按钮 */
.add-footer {
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #EEEEEE;
}

.save-btn {
  padding: 28rpx;
  background-color: #E6E6E6;
  color: #999999;
  text-align: center;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.save-btn.active {
  background-color: #3366CC;
  color: #FFFFFF;
}

/* 日期选择器弹窗 */
.picker-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 2000;
  visibility: hidden;
  opacity: 0;
  transition: all 0.3s ease;
}

.picker-modal.show {
  visibility: visible;
  opacity: 1;
}

.picker-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
}

.picker-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #FFFFFF;
  border-radius: 24rpx 24rpx 0 0;
  padding-bottom: env(safe-area-inset-bottom);
}

.picker-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  border-bottom: 1rpx solid #EEEEEE;
  font-size: 30rpx;
  color: #3366CC;
}

.picker-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.date-picker {
  height: 400rpx;
}

.picker-item {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}
