/* pages/health/checkup.wxss */

/* 页面容器 */
.container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background-color: #FFFBF5;
  padding-bottom: 140rpx;
}

/* 筛选栏 */
.filter-bar {
  padding: 20rpx 30rpx;
  background-color: #FFFFFF;
}

.filter-tabs {
  display: flex;
  gap: 20rpx;
}

.filter-tab {
  padding: 12rpx 24rpx;
  background-color: #FFFBF5;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #666666;
}

.filter-tab.active {
  background-color: #FFF0E5;
  color: #FF8A65;
  font-weight: 600;
}

/* 体重趋势图 */
.weight-chart-section {
  margin: 24rpx 30rpx;
  padding: 24rpx;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(180, 160, 140, 0.08);
}

.chart-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.chart-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}

.chart-subtitle {
  font-size: 24rpx;
  color: #999999;
}

.chart-canvas {
  width: 100%;
  height: 200rpx;
}

/* 记录列表 */
.record-list {
  flex: 1;
  padding: 20rpx 30rpx;
}

.record-item {
  margin-bottom: 24rpx;
}

.record-card {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 30rpx;
  position: relative;
  box-shadow: 0 8rpx 24rpx rgba(180, 160, 140, 0.08);
}

.record-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.checkup-type-badge {
  padding: 8rpx 16rpx;
  background-color: #FFF0E5;
  color: #FF8A65;
  font-size: 22rpx;
  border-radius: 8rpx;
}

.record-date {
  font-size: 24rpx;
  color: #999999;
}

.record-body {
  margin-bottom: 16rpx;
}

.body-title {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.checkup-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.checkup-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

/* 信息网格 */
.info-grid {
  display: flex;
  gap: 40rpx;
  margin-bottom: 16rpx;
}

.info-item {
  display: flex;
  flex-direction: column;
}

.info-label {
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 4rpx;
}

.info-value {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

/* 体检结果 */
.result-section {
  padding: 16rpx;
  background-color: #FFFBF5;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.result-label {
  font-size: 24rpx;
  color: #666666;
  display: block;
  margin-bottom: 8rpx;
}

.result-text {
  font-size: 28rpx;
  color: #333333;
  line-height: 1.5;
}

/* 医院信息 */
.hospital-info {
  display: flex;
  align-items: center;
}

.hospital-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.hospital-name {
  font-size: 26rpx;
  color: #666666;
}

/* 附件标识 */
.attachment-badge {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  font-size: 32rpx;
}

/* 记录底部 */
.record-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid #F0F0F0;
}

.record-age {
  font-size: 24rpx;
  color: #999999;
}

.record-actions {
  display: flex;
  gap: 20rpx;
}

.action-btn {
  font-size: 26rpx;
  color: #FF8A65;
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 30rpx;
  color: #999999;
  font-size: 26rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 28rpx;
  color: #999999;
}

/* 添加按钮 */
.add-btn {
  position: fixed;
  right: 40rpx;
  bottom: 180rpx;
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFB74D 0%, #FF8A65 100%);
  box-shadow: 0 8rpx 24rpx rgba(255, 138, 101, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
}

.add-icon {
  font-size: 60rpx;
  color: #FFFFFF;
  font-weight: 300;
}

/* 底部导航栏占位 */
.tab-bar-placeholder {
  height: 100rpx;
}
