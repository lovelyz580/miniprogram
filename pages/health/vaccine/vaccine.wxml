<!-- pages/health/vaccine.wxml -->
<view class="container">
  <!-- 顶部统计 -->
  <view class="stats-bar">
    <view class="stat-item">
      <text class="stat-value">{{totalCount}}</text>
      <text class="stat-label">接种总数</text>
    </view>
    <view class="stat-item">
      <text class="stat-value">{{nextVaccineDays}}</text>
      <text class="stat-label">下次接种</text>
    </view>
    <view class="stat-item">
      <text class="stat-value">{{protectedCount}}</text>
      <text class="stat-label">已防疾病</text>
    </view>
  </view>

  <!-- 下次接种提醒 -->
  <view class="next-reminder" wx:if="{{nextVaccine}}" bindtap="showNextDetail">
    <view class="reminder-badge">
      <text>下次接种</text>
    </view>
    <view class="reminder-content">
      <text class="vaccine-name">{{nextVaccine.vaccineName}}</text>
      <text class="vaccine-date">预计日期：{{nextVaccine.vaccineDate}}</text>
    </view>
    <text class="reminder-arrow">›</text>
  </view>

  <!-- 疫苗记录列表 -->
  <scroll-view 
    class="record-list" 
    scroll-y
    bindscrolltolower="loadMore"
    refresher-enabled 
    refresher-triggered="{{isRefreshing}}"
    bindrefresherrefresh="onRefresh"
  >
    <!-- 时间线头部 -->
    <!-- <view class="timeline-header">
      <view class="timeline-line"></view>
      <text class="timeline-title">接种记录</text>
      <view class="timeline-line"></view>
    </view> -->

    <view class="record-item" wx:for="{{records}}" wx:key="recordId">
      <!-- 时间线节点 -->
      <view class="timeline-node">
        <view class="node-dot"></view>
        <view class="node-line"></view>
      </view>
      
      <!-- 记录卡片 -->
      <view class="record-card" bindtap="showDetail" data-id="{{item.recordId}}">
        <view class="record-header">
          <view class="vaccine-tag">
            <text>{{item.vaccineType}}</text>
          </view>
          <text class="record-date">{{item.vaccineDate}}</text>
        </view>
        
        <view class="record-body">
          <view class="vaccine-name-row">
            <text class="vaccine-icon">💉</text>
            <text class="vaccine-name">{{item.vaccineName}}</text>
          </view>
          <view class="record-detail" wx:if="{{item.hospitalName}}">
            <text class="detail-label">接种医院：</text>
            <text class="detail-value">{{item.hospitalName}}</text>
          </view>
          <view class="record-detail" wx:if="{{item.batchNo}}">
            <text class="detail-label">疫苗批号：</text>
            <text class="detail-value">{{item.batchNo}}</text>
          </view>
          <view class="record-detail" wx:if="{{item.doctor}}">
            <text class="detail-label">接种医生：</text>
            <text class="detail-value">{{item.doctor}}</text>
          </view>
        </view>
        
        <view class="record-footer">
          <text class="record-age">宠龄：{{item.petAge}}</text>
          <text class="record-note" wx:if="{{item.notes}}">{{item.notes}}</text>
        </view>
      </view>
    </view>

    <!-- 加载状态 -->
    <view class="load-more" wx:if="{{records.length > 0}}">
      <text wx:if="{{hasMore}}">加载中...</text>
      <text wx:else>没有更多了</text>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{records.length === 0 && !isLoading}}">
      <text class="empty-icon">💉</text>
      <text class="empty-title">还没有疫苗记录哦</text>
      <text class="empty-desc">给TA的健康打个卡吧~</text>
    </view>
  </scroll-view>

  <!-- 添加按钮 -->
  <view class="add-btn" bindtap="goToAdd">
    <text class="add-icon">🐾</text>
  </view>

  <!-- 底部导航栏占位 -->
  <view class="tab-bar-placeholder"></view>
</view>
