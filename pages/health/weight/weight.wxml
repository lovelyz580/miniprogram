<!-- pages/health/weight.wxml -->
<view class="container">
  <!-- 当前体重卡片 -->
  <view class="current-weight-card">
    <view class="weight-display">
      <text class="weight-value">{{currentWeight}}</text>
      <text class="weight-unit">kg</text>
    </view>
    <view class="weight-meta">
      <text class="record-date">记录于 {{recordDate}}</text>
      <text class="weight-change {{changeType}}">
        {{changeType === 'up' ? ' ↑ ' : changeType === 'down' ? ' ↓ ' : ''}} {{changeValue}}kg
      </text>
    </view>
  </view>

  <!-- 健康体重范围 -->
  <view class="healthy-range">
    <view class="range-bar">
      <view class="range-indicator" style="left: {{rangePosition}} '%'"></view>
    </view>
    <view class="range-labels">
      <text class="range-label">偏瘦</text>
      <text class="range-label range-optimal">理想</text>
      <text class="range-label">偏胖</text>
    </view>
    <view class="range-values">
      <text>{{minHealthyWeight}}kg</text>
      <text>{{maxHealthyWeight}}kg</text>
    </view>
    <view class="range-tip">
      <text wx:if="{{isHealthy}}">✅ 当前体重在健康范围内</text>
      <text wx:else class="warning">⚠️ 当前体重{{isTooLight ? '偏低' : '偏高'}}</text>
    </view>
  </view>

  <!-- 体重趋势图 -->
  <view class="trend-section">
    <view class="section-header">
      <text class="section-title">体重趋势</text>
      <view class="time-tabs">
        <text 
          class="time-tab {{timeRange === 'week' ? 'active' : ''}}" 
          bindtap="changeTimeRange" 
          data-range="week"
        >周</text>
        <text 
          class="time-tab {{timeRange === 'month' ? 'active' : ''}}" 
          bindtap="changeTimeRange" 
          data-range="month"
        >月</text>
        <text 
          class="time-tab {{timeRange === 'year' ? 'active' : ''}}" 
          bindtap="changeTimeRange" 
          data-range="year"
        >年</text>
      </view>
    </view>
    <canvas canvas-id="trendCanvas" class="trend-chart"></canvas>
    <view class="trend-stats">
      <view class="stat-item">
        <text class="stat-label">平均值</text>
        <text class="stat-value">{{avgWeight}}kg</text>
      </view>
      <view class="stat-item">
        <text class="stat-label">最高</text>
        <text class="stat-value">{{maxWeight}}kg</text>
      </view>
      <view class="stat-item">
        <text class="stat-label">最低</text>
        <text class="stat-value">{{minWeight}}kg</text>
      </view>
    </view>
  </view>

  <!-- 体重记录列表 -->
  <view class="record-section">
    <view class="section-header">
      <text class="section-title">记录列表</text>
      <text class="section-count">{{totalCount}}条</text>
    </view>
    
    <view class="record-list">
      <view class="record-item" wx:for="{{records}}" wx:key="id">
        <view class="record-date-col">
          <text class="record-day">{{item.day}}</text>
          <text class="record-month">{{item.month}}</text>
        </view>
        <view class="record-weight-col">
          <text class="record-weight">{{item.weight}}</text>
          <text class="record-unit">kg</text>
        </view>
        <view class="record-note-col">
          <text class="record-note" wx:if="{{item.notes}}">{{item.notes}}</text>
          <text class="record-health" wx:if="{{item.healthStatus}}">{{item.healthStatus}}</text>
        </view>
        <view class="record-actions">
          <text class="edit-btn" catchtap="editRecord" data-id="{{item.recordId}}">编辑</text>
          <text class="delete-btn" catchtap="deleteRecord" data-id="{{item.recordId}}">删除</text>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{records.length === 0 && !isLoading}}">
      <text class="empty-icon">⚖️</text>
      <text class="empty-title">还没有体重记录哦</text>
      <text class="empty-desc">快来记录TA的成长轨迹吧~</text>
    </view>

    <!-- 加载更多 -->
    <view class="load-more" wx:if="{{records.length > 0 && hasMore}}">
      <text>加载更多...</text>
    </view>
  </view>

  <!-- 添加按钮 -->
  <view class="add-btn" bindtap="showAddModal">
    <text class="add-icon">🐾</text>
  </view>

  <!-- 底部导航栏占位 -->
  <view class="tab-bar-placeholder"></view>
</view>

<!-- 添加/编辑体重记录弹窗 -->
<view class="modal-mask" wx:if="{{showModal}}" bindtap="hideModal">
  <view class="modal-content" catchtap="preventBubble">
    <view class="modal-header">
      <text class="modal-title">{{editingId ? '编辑记录' : '添加体重记录'}}</text>
      <text class="modal-close" bindtap="hideModal">×</text>
    </view>
    <view class="modal-body">
      <view class="input-group">
        <text class="input-label">体重 (kg)</text>
        <input 
          type="digit" 
          class="weight-input" 
          placeholder="请输入体重" 
          value="{{inputWeight}}"
          bindinput="onWeightInput"
        />
      </view>
      <view class="input-group">
        <text class="input-label">记录日期</text>
        <picker mode="date" value="{{inputDate}}" bindchange="onDateChange">
          <view class="date-picker">
            <text>{{inputDate || '请选择日期'}}</text>
            <text class="arrow">›</text>
          </view>
        </picker>
      </view>
      <view class="input-group">
        <text class="input-label">备注</text>
        <input 
          type="text" 
          class="note-input" 
          placeholder="可选：进食、运动等" 
          value="{{inputNote}}"
          bindinput="onNoteInput"
        />
      </view>
    </view>
    <view class="modal-footer">
      <button class="cancel-btn" bindtap="hideModal">取消</button>
      <button class="confirm-btn" bindtap="saveRecord">保存</button>
    </view>
  </view>
</view>
