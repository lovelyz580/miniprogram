/* pages/health/index.wxss */

/* 页面容器 */
.container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background-color: #FFFBF5;
  padding-bottom: 140rpx;
}

/* 宠物信息栏 */
.pet-info-bar {
  display: flex;
  align-items: center;
  padding: 30rpx;
  background-color: #FFFFFF;
  border-bottom: none;
  box-shadow: 0 4rpx 16rpx rgba(180, 160, 140, 0.06);
}

.pet-avatar-wrapper {
  position: relative;
  margin-right: 20rpx;
}

.pet-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background-color: #E6E6E6;
}

.pet-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background-color: #FF6B6B;
  color: #FFFFFF;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pet-detail {
  flex: 1;
}

.pet-name-row {
  display: flex;
  align-items: center;
}

.pet-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #333333;
}

.pet-breed {
  font-size: 26rpx;
  color: #8C7A70;
  margin-left: 12rpx;
  padding: 4rpx 12rpx;
  background-color: #FFF0E5;
  border-radius: 20rpx;
}

.pet-age {
  font-size: 26rpx;
  color: #A89F9A;
  margin-top: 8rpx;
  display: block;
}

.add-pet-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFB74D 0%, #FF8A65 100%);
  color: #FFFFFF;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(255, 138, 101, 0.3);
}

/* 健康概览卡片 */
.health-overview {
  margin: 24rpx 30rpx;
  padding: 30rpx;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(180, 160, 140, 0.08);
}

.overview-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.overview-title text:first-child {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.overview-time {
  font-size: 24rpx;
  color: #999999;
}

.weight-trend {
  position: relative;
  height: 200rpx;
}

.weight-chart {
  width: 100%;
  height: 160rpx;
}

.weight-info {
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  text-align: right;
}

.weight-current {
  display: flex;
  align-items: baseline;
  justify-content: flex-end;
}

.weight-value {
  font-size: 56rpx;
  font-weight: 700;
  color: #FF8A65;
}

.weight-unit {
  font-size: 28rpx;
  color: #999999;
  margin-left: 8rpx;
}

.weight-change {
  font-size: 26rpx;
  color: #999999;
  margin-top: 8rpx;
}

.weight-change.up {
  color: #FF6B6B;
}

.weight-change.down {
  color: #52C41A;
}

.empty-weight {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx;
  background-color: #FFFBF5;
  border-radius: 20rpx;
}

.empty-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
}

/* 健康记录入口卡片 */
.health-cards {
  margin: 20rpx 30rpx;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.health-card {
  display: flex;
  align-items: center;
  padding: 30rpx;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(180, 160, 140, 0.08);
}

.card-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 20rpx;
}

.vaccine-icon {
  background-color: #E6F7FF;
}

.checkup-icon {
  background-color: #FFF7E6;
}

.medication-icon {
  background-color: #F6FFED;
}

.weight-icon {
  background-color: #FFF1F0;
}

.card-content {
  flex: 1;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  display: block;
}

.card-desc {
  font-size: 24rpx;
  color: #999999;
  margin-top: 6rpx;
  display: block;
}

.card-arrow {
  font-size: 32rpx;
  color: #CCCCCC;
}

/* 健康提醒列表 */
.reminder-section {
  margin: 20rpx 30rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.section-more {
  font-size: 26rpx;
  color: #FF8A65;
}

.reminder-list {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(180, 160, 140, 0.08);
}

.reminder-item {
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.reminder-item:last-child {
  border-bottom: none;
}

.reminder-left {
  flex: 1;
  display: flex;
  align-items: center;
}

.reminder-tag {
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  margin-right: 20rpx;
}

.reminder-tag-vaccine {
  background-color: #E6F7FF;
  color: #1890FF;
}

.reminder-tag-checkup {
  background-color: #FFF7E6;
  color: #FA8C16;
}

.reminder-tag-medication {
  background-color: #F6FFED;
  color: #52C41A;
}

.reminder-tag-other {
  background-color: #FFF1F0;
  color: #FF4D4F;
}

.reminder-info {
  flex: 1;
}

.reminder-title {
  font-size: 28rpx;
  color: #333333;
  display: block;
}

.reminder-date {
  font-size: 24rpx;
  color: #999999;
  margin-top: 4rpx;
  display: block;
}

.reminder-status {
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
}

.reminder-status.pending {
  background-color: #FFF7E6;
  color: #FA8C16;
}

.reminder-status.done {
  background-color: #F6FFED;
  color: #52C41A;
}

.reminder-status.overdue {
  background-color: #FFF1F0;
  color: #FF4D4F;
}

.empty-reminder {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(180, 160, 140, 0.08);
}

.empty-action {
  margin-top: 24rpx;
  padding: 16rpx 40rpx;
  background: linear-gradient(135deg, #FFB74D 0%, #FF8A65 100%);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 40rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 138, 101, 0.3);
}

/* 底部导航栏占位 */
.tab-bar-placeholder {
  height: 100rpx;
}

/* 爪印记忆暖系主题强化 */
.container {
  background:
    radial-gradient(circle at 86% 4%, rgba(132, 183, 108, 0.16) 0, rgba(132, 183, 108, 0) 180rpx),
    linear-gradient(180deg, #FFF4E7 0%, #FFF9F1 52%, #F7F1E8 100%);
}

.pet-info-bar {
  margin: 24rpx 28rpx 0;
  border-radius: 26rpx;
  background: linear-gradient(135deg, #FFFFFF 0%, #FFF7EC 100%);
  border: 1rpx solid rgba(240, 223, 200, 0.82);
  box-shadow: 0 10rpx 28rpx rgba(146, 103, 67, 0.09);
}

.pet-avatar {
  border: 5rpx solid #FFFFFF;
  box-shadow: 0 6rpx 16rpx rgba(146, 103, 67, 0.12);
}

.pet-name,
.overview-title text:first-child,
.card-title,
.section-title,
.reminder-title {
  color: #4B3B32;
}

.pet-breed,
.empty-weight,
.reminder-tag-vaccine,
.reminder-tag-checkup,
.reminder-tag-medication,
.reminder-tag-other,
.reminder-status.pending {
  border-radius: 999rpx;
}

.health-overview,
.health-card,
.reminder-list,
.empty-reminder {
  border: 1rpx solid rgba(240, 223, 200, 0.82);
  box-shadow: 0 10rpx 28rpx rgba(146, 103, 67, 0.09);
}

.health-overview {
  background: linear-gradient(180deg, #FFFFFF 0%, #FFF9F1 100%);
}

.weight-value,
.section-more {
  color: #D87545;
}

.add-pet-btn,
.empty-action {
  background: linear-gradient(135deg, #F7A45A 0%, #E87852 100%);
  box-shadow: 0 8rpx 20rpx rgba(232, 120, 82, 0.24);
}

.vaccine-icon {
  background-color: #FFF0DE;
}

.checkup-icon {
  background-color: #EAF5E8;
}

.medication-icon {
  background-color: #F5EADF;
}

.weight-icon {
  background-color: #FFE8DD;
}

.reminder-tag-vaccine {
  background-color: #FFF0DE;
  color: #D87545;
}

.reminder-tag-checkup,
.reminder-status.done {
  background-color: #EAF6EA;
  color: #5B9B67;
}

.reminder-tag-medication {
  background-color: #F5EADF;
  color: #9A704F;
}

.reminder-tag-other,
.reminder-status.overdue {
  background-color: #FFE8DD;
  color: #E87852;
}
