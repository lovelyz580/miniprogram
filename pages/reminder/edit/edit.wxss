/* pages/reminder/edit/edit.wxss */

/* 页面容器 */
.container {
  min-height: 100vh;
  background-color: #F5F7FA;
  padding-bottom: 40rpx;
}

/* 加载状态 */
.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 100rpx;
  color: #999999;
  font-size: 28rpx;
}

/* 顶部导航栏 */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background-color: #FFFFFF;
  border-bottom: 1rpx solid #EEEEEE;
}

.nav-cancel {
  font-size: 28rpx;
  color: #666666;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333333;
}

.nav-save {
  font-size: 28rpx;
  color: #CCCCCC;
  padding: 10rpx 24rpx;
  border-radius: 32rpx;
  background-color: #F5F7FA;
}

.nav-save.active {
  color: #FFFFFF;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.3);
}

/* 表单容器 */
.form-container {
  padding: 20rpx 30rpx;
}

/* 表单区域 */
.form-section {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.form-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  padding: 30rpx 30rpx 20rpx;
  border-bottom: 1rpx solid #F5F7FA;
}

/* 表单项 */
.form-item {
  display: flex;
  align-items: flex-start;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #F5F7FA;
}

.form-item.vertical {
  flex-direction: column;
  align-items: flex-start;
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  width: 180rpx;
  font-size: 28rpx;
  color: #333333;
  flex-shrink: 0;
  padding-top: 4rpx;
}

.required {
  color: #FF4D4F;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
  text-align: right;
}

.form-input.placeholder {
  color: #CCCCCC;
}

.form-textarea {
  flex: 1;
  width: 100%;
  font-size: 28rpx;
  color: #333333;
  min-height: 120rpx;
  margin-top: 16rpx;
  line-height: 1.6;
  background-color: #F5F7FA;
  border-radius: 12rpx;
  padding: 16rpx;
}

.form-picker {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  font-size: 28rpx;
  color: #333333;
}

.form-picker .placeholder {
  color: #CCCCCC;
}

.picker-arrow {
  font-size: 32rpx;
  color: #CCCCCC;
  margin-left: 12rpx;
}

/* 分类选择器 */
.category-selector {
  flex: 1;
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
}

.category-option {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background-color: #F5F7FA;
  transition: all 0.3s ease;
}

.category-option.active {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.3);
}

.category-icon {
  font-size: 32rpx;
  margin-bottom: 6rpx;
}

.category-text {
  font-size: 22rpx;
  color: #666666;
}

.category-option.active .category-text {
  color: #FFFFFF;
}

/* 重复类型选择器 */
.repeat-selector {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 12rpx;
}

.repeat-option {
  padding: 10rpx 20rpx;
  font-size: 24rpx;
  color: #666666;
  background-color: #F5F7FA;
  border-radius: 24rpx;
  transition: all 0.3s ease;
}

.repeat-option.active {
  color: #FFFFFF;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  box-shadow: 0 2rpx 8rpx rgba(102, 126, 234, 0.3);
}

/* 选择器弹窗 */
.picker-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
}

.picker-modal.show {
  opacity: 1;
  visibility: visible;
}

.picker-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #FFFFFF;
  border-radius: 24rpx 24rpx 0 0;
  transform: translateY(100%);
  transition: transform 0.3s ease;
}

.picker-modal.show .picker-content {
  transform: translateY(0);
}

.pet-picker {
  max-height: 600rpx;
}

/* 选择器头部 */
.picker-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.picker-cancel {
  font-size: 28rpx;
  color: #999999;
}

.picker-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.picker-confirm {
  font-size: 28rpx;
  color: #667eea;
  font-weight: 500;
}

/* 选择器视图 */
.picker-view {
  height: 400rpx;
}

.picker-item {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #333333;
}
