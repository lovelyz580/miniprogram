/* pages/reminder/detail/detail.wxss */

/* 页面容器 */
.container {
  min-height: 100vh;
  background-color: #F5F7FA;
  padding-bottom: 140rpx;
}

/* 顶部渐变背景 */
.header-bg {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 40rpx 30rpx 80rpx;
}

.header-content {
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 分类标签 */
.category-badge {
  display: flex;
  align-items: center;
  padding: 10rpx 24rpx;
  background-color: rgba(255, 255, 255, 0.2);
  border-radius: 30rpx;
  margin-bottom: 24rpx;
}

.category-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.category-text {
  font-size: 24rpx;
  color: #FFFFFF;
}

/* 提醒标题 */
.reminder-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #FFFFFF;
  text-align: center;
  margin-bottom: 24rpx;
}

/* 状态指示器 */
.status-indicator {
  display: flex;
  align-items: center;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}

.status-indicator.pending {
  background-color: rgba(255, 255, 255, 0.2);
}

.status-indicator.overdue {
  background-color: rgba(255, 77, 79, 0.3);
}

.status-indicator.completed {
  background-color: rgba(149, 222, 100, 0.3);
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 10rpx;
}

.status-indicator.pending .status-dot {
  background-color: #FFE066;
}

.status-indicator.overdue .status-dot {
  background-color: #FF4D4F;
}

.status-indicator.completed .status-dot {
  background-color: #95DE64;
}

.status-text {
  font-size: 24rpx;
  color: #FFFFFF;
}

/* 详情内容区 */
.detail-content {
  margin-top: -50rpx;
  padding: 0 30rpx;
}

/* 信息卡片 */
.info-card {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.info-row {
  display: flex;
  margin-bottom: 24rpx;
}

.info-row:last-child {
  margin-bottom: 0;
}

.info-item {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.info-label {
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 8rpx;
}

.info-value {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
}

/* 描述卡片 */
.desc-card {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 16rpx;
}

.desc-text {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.6;
}

/* 完成信息卡片 */
.complete-card {
  background-color: #F0F9EB;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.complete-info {
  display: flex;
  align-items: center;
}

.complete-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.complete-text {
  font-size: 28rpx;
  color: #67C23A;
}

/* 底部操作栏 */
.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  justify-content: space-around;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background-color: #FFFFFF;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 32rpx;
  border-radius: 16rpx;
  background-color: #F5F7FA;
  transition: all 0.3s ease;
}

.action-btn:active {
  transform: scale(0.95);
}

.action-icon {
  font-size: 36rpx;
  margin-bottom: 6rpx;
}

.action-text {
  font-size: 24rpx;
  color: #666666;
}

/* 编辑按钮 */
.edit-btn {
  background-color: #E6F0FF;
}

.edit-btn .action-text {
  color: #3366CC;
}

/* 完成按钮 */
.complete-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.3);
}

.complete-btn .action-text {
  color: #FFFFFF;
}

.complete-btn.undo {
  background: linear-gradient(135deg, #909399 0%, #606266 100%);
  box-shadow: 0 4rpx 12rpx rgba(144, 147, 153, 0.3);
}

/* 删除按钮 */
.delete-btn {
  background-color: #FFF1F0;
}

.delete-btn .action-text {
  color: #FF4D4F;
}

/* 删除确认弹窗 */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
}

.modal.show {
  opacity: 1;
  visibility: visible;
}

.modal-content {
  width: 560rpx;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 40rpx;
  transform: scale(0.9);
  transition: transform 0.3s ease;
}

.modal.show .modal-content {
  transform: scale(1);
}

.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333333;
  text-align: center;
  display: block;
  margin-bottom: 16rpx;
}

.modal-message {
  font-size: 28rpx;
  color: #666666;
  text-align: center;
  display: block;
  margin-bottom: 40rpx;
  line-height: 1.5;
}

.modal-actions {
  display: flex;
  gap: 20rpx;
}

.modal-btn {
  flex: 1;
  padding: 24rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
  text-align: center;
}

.modal-btn.cancel {
  background-color: #F5F7FA;
  color: #666666;
}

.modal-btn.confirm {
  background-color: #FF4D4F;
  color: #FFFFFF;
}
