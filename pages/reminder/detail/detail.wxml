<!-- pages/reminder/detail/detail.wxml -->
<view class="container">
  <!-- 顶部渐变背景 -->
  <view class="header-bg">
    <view class="header-content">
      <!-- 分类标签 -->
      <view class="category-badge category-badge-{{detail.reminderType}}">
        <text class="category-icon">{{detail.categoryIcon}}</text>
        <text class="category-text">{{detail.categoryText}}</text>
      </view>
      
      <!-- 提醒标题 -->
      <text class="reminder-title">{{detail.title}}</text>
      
      <!-- 状态指示 -->
      <view class="status-indicator {{detail.isCompleted ? 'completed' : (detail.isOverdue ? 'overdue' : 'pending')}}">
        <text class="status-dot"></text>
        <text class="status-text">{{detail.StatusText}}</text>
      </view>
    </view>
  </view>

  <!-- 详情内容区 -->
  <view class="detail-content">
    <!-- 基本信息卡片 -->
    <view class="info-card">
      <view class="info-row">
        <view class="info-item">
          <text class="info-label">📅 提醒日期</text>
          <text class="info-value">{{detail.remindDate}}</text>
        </view>
        <view class="info-item">
          <text class="info-label">⏰ 提醒时间</text>
          <text class="info-value">{{detail.remindTime}}</text>
        </view>
      </view>
      
      <view class="info-row">
        <view class="info-item">
          <text class="info-label">🔄 重复类型</text>
          <text class="info-value">{{detail.repeatText}}</text>
        </view>
        <view class="info-item">
          <text class="info-label">🐾 关联宠物</text>
          <text class="info-value">{{detail.petName || '未指定'}}</text>
        </view>
      </view>
    </view>

    <!-- 描述信息 -->
    <view class="desc-card" wx:if="{{detail.description}}">
      <view class="card-title">描述说明</view>
      <text class="desc-text">{{detail.description}}</text>
    </view>

    <!-- 完成信息 -->
    <view class="complete-card" wx:if="{{detail.isCompleted && detail.completedDate}}">
      <view class="card-title">完成信息</view>
      <view class="complete-info">
        <text class="complete-icon">✅</text>
        <text class="complete-text">已于 {{detail.completedDate}} 完成</text>
      </view>
    </view>
  </view>

  <!-- 底部操作栏 -->
  <view class="action-bar">
    <view class="action-btn edit-btn" bindtap="onEdit">
      <text class="action-icon">✏️</text>
      <text class="action-text">编辑</text>
    </view>
    
    <view class="action-btn complete-btn {{detail.isCompleted ? 'undo' : ''}}" bindtap="onToggleComplete">
      <text class="action-icon">{{detail.isCompleted ? '↩️' : '✅'}}</text>
      <text class="action-text">{{detail.isCompleted ? '取消完成' : '标记完成'}}</text>
    </view>
    
    <view class="action-btn delete-btn" bindtap="onDelete">
      <text class="action-icon">🗑️</text>
      <text class="action-text">删除</text>
    </view>
  </view>
</view>

<!-- 删除确认弹窗 -->
<view class="modal {{showDeleteModal ? 'show' : ''}}" catchtap="hideDeleteModal">
  <view class="modal-content" catchtap="stopPropagation">
    <text class="modal-title">确认删除</text>
    <text class="modal-message">确定要删除这条提醒吗？删除后无法恢复。</text>
    <view class="modal-actions">
      <view class="modal-btn cancel" catchtap="hideDeleteModal">取消</view>
      <view class="modal-btn confirm" catchtap="confirmDelete">确定删除</view>
    </view>
  </view>
</view>
