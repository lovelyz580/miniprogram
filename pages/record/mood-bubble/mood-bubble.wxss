/* mood-bubble.wxss */

.container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background-color: #FFFBF5;
  padding-bottom: 40rpx;
}

/* 顶部导航 */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background-color: #FFFFFF;
  border-bottom: none;
  box-shadow: 0 4rpx 16rpx rgba(180, 160, 140, 0.06);
  position: sticky;
  top: 0;
  z-index: 100;
}

.back-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  font-size: 48rpx;
  color: #333333;
}

.header-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333333;
}

.publish-btn {
  padding: 12rpx 32rpx;
  background: linear-gradient(135deg, #FFB74D 0%, #FF8A65 100%);
  border-radius: 40rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 138, 101, 0.3);
}

.publish-btn text {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: 600;
}

.publish-btn.disabled {
  opacity: 0.4;
}

/* 通用区块 */
.section {
  background-color: #FFFFFF;
  margin: 24rpx 30rpx;
  padding: 30rpx;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(180, 160, 140, 0.08);
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 24rpx;
  display: block;
}

/* 心情标签 */
.mood-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.mood-tag {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  border-radius: 40rpx;
  transition: all 0.3s ease;
}

.mood-tag .tag-emoji {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.mood-tag .tag-name {
  font-size: 28rpx;
  font-weight: 600;
}

/* 媒体选择区 */
.media-area {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.media-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.media-item image {
  width: 100%;
  height: 100%;
}

.media-delete {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 48rpx;
  height: 48rpx;
  background-color: rgba(0, 0, 0, 0.6);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.media-delete text {
  font-size: 36rpx;
  color: #FFFFFF;
  font-weight: 300;
}

.media-add {
  width: 200rpx;
  height: 200rpx;
  background-color: #FFFBF5;
  border: 2rpx dashed #FFDAB9;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.add-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.add-text {
  font-size: 24rpx;
  color: #999999;
}

.media-tip {
  font-size: 24rpx;
  color: #999999;
  display: block;
  margin-top: 16rpx;
}

/* 文字输入 */
.content-input {
  width: 100%;
  min-height: 200rpx;
  font-size: 28rpx;
  color: #333333;
  line-height: 1.6;
}

.content-count {
  font-size: 24rpx;
  color: #CCCCCC;
  float: right;
}

/* 自动信息区 */
.info-section {
  margin: 24rpx 30rpx;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(180, 160, 140, 0.08);
}

.info-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  border-bottom: 1rpx solid #FFF0E5;
}

.info-item:last-child {
  border-bottom: none;
}

.info-left {
  display: flex;
  align-items: center;
}

.info-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.info-label {
  font-size: 28rpx;
  color: #333333;
}

.info-right {
  display: flex;
  align-items: center;
}

.info-value {
  font-size: 26rpx;
  color: #666666;
}

.info-value.placeholder {
  color: #CCCCCC;
}

.info-value.highlight {
  color: #FF8A65;
  font-weight: 600;
}

.info-toggle {
  font-size: 32rpx;
  margin-left: 16rpx;
}

.pet-avatar-small {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  margin-right: 12rpx;
}

/* 预览卡片 */
.preview-card {
  margin: 24rpx 30rpx;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(180, 160, 140, 0.08);
}

.preview-header {
  padding: 20rpx 30rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.preview-title {
  font-size: 24rpx;
  color: #999999;
}

.preview-content {
  padding: 24rpx 30rpx;
}

.preview-tag {
  display: inline-block;
  padding: 8rpx 20rpx;
  background-color: #FFE8E8;
  border-radius: 20rpx;
  margin-bottom: 16rpx;
}

.preview-tag text {
  font-size: 24rpx;
  color: #FF6B6B;
  font-weight: 600;
}

.preview-images {
  position: relative;
  width: 100%;
  height: 300rpx;
  margin-bottom: 16rpx;
}

.preview-image {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.preview-more {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  padding: 8rpx 16rpx;
  background-color: rgba(0, 0, 0, 0.6);
  border-radius: 8rpx;
  color: #FFFFFF;
  font-size: 24rpx;
}

.preview-meta {
  font-size: 24rpx;
  color: #999999;
}

.preview-meta .highlight {
  color: #FF8A65;
  font-weight: 600;
}

/* 发布loading */
.loading-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.loading-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx;
  background-color: #FFFFFF;
  border-radius: 16rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #F0F0F0;
  border-top-color: #FF8A65;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.loading-text {
  font-size: 28rpx;
  color: #666666;
  margin-top: 24rpx;
}
