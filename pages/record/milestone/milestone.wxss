/* milestone.wxss */

/* 页面容器 */
.container {
  min-height: 100vh;
  background-color: #F5F7FA;
  padding-bottom: 40rpx;
}

/* 顶部导航栏 */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background-color: #FFFFFF;
  border-bottom: 1rpx solid #EEEEEE;
}

.nav-cancel {
  font-size: 28rpx;
  color: #666666;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333333;
}

.nav-save {
  font-size: 28rpx;
  color: #CCCCCC;
  padding: 10rpx 24rpx;
  border-radius: 32rpx;
  background-color: #F5F7FA;
}

.nav-save.active {
  color: #FFFFFF;
  background-color: #3366CC;
}

/* 通用标题 */
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 20rpx;
}

/* 日期选择 */
.date-section {
  padding: 30rpx;
  background-color: #FFFFFF;
  margin-top: 20rpx;
}

.date-selector {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background-color: #F5F7FA;
  border-radius: 12rpx;
}

.date-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.date-text {
  flex: 1;
  font-size: 30rpx;
  color: #333333;
}

.date-arrow {
  font-size: 32rpx;
  color: #999999;
}

/* 宠物选择 */
.pet-section {
  padding: 30rpx;
  background-color: #FFFFFF;
  margin-top: 2rpx;
}

.pet-card {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background-color: #F5F7FA;
  border-radius: 16rpx;
  border: 2rpx solid transparent;
}

.pet-card.active {
  background-color: #E6F0FF;
  border-color: #3366CC;
}

.pet-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.pet-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.pet-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}

.pet-breed {
  font-size: 24rpx;
  color: #999999;
  margin-top: 4rpx;
}

.pet-arrow {
  font-size: 32rpx;
  color: #999999;
}

/* 里程碑类型 */
.type-section {
  padding: 30rpx;
  background-color: #FFFFFF;
  margin-top: 20rpx;
}

.type-tabs {
  display: flex;
  background-color: #F5F7FA;
  border-radius: 12rpx;
  padding: 6rpx;
  margin-bottom: 24rpx;
}

.type-tab {
  flex: 1;
  padding: 16rpx;
  text-align: center;
  font-size: 28rpx;
  color: #666666;
  border-radius: 8rpx;
}

.type-tab.active {
  background-color: #3366CC;
  color: #FFFFFF;
}

/* 预设里程碑列表 */
.preset-list {
  display: flex;
  flex-wrap: wrap;
}

.preset-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 150rpx;
  padding: 24rpx 16rpx;
  background-color: #F5F7FA;
  border-radius: 16rpx;
  margin-right: 20rpx;
  margin-bottom: 20rpx;
  border: 2rpx solid transparent;
}

.preset-item:nth-child(4n) {
  margin-right: 0;
}

.preset-item.active {
  background-color: #E6F0FF;
  border-color: #3366CC;
}

.preset-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.preset-name {
  font-size: 24rpx;
  color: #666666;
  text-align: center;
}

.preset-item.active .preset-name {
  color: #3366CC;
}

/* 自定义表单 */
.custom-form {
  padding: 20rpx;
  background-color: #F5F7FA;
  border-radius: 16rpx;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 12rpx;
}

.form-input {
  width: 100%;
  padding: 20rpx;
  background-color: #FFFFFF;
  border-radius: 12rpx;
  font-size: 30rpx;
}

.icon-picker {
  display: flex;
  flex-wrap: wrap;
}

.icon-option {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #FFFFFF;
  border-radius: 12rpx;
  margin-right: 16rpx;
  margin-bottom: 16rpx;
  font-size: 40rpx;
  border: 2rpx solid transparent;
}

.icon-option.active {
  border-color: #3366CC;
  background-color: #E6F0FF;
}

/* 媒体区域 */
.media-section {
  padding: 30rpx;
  background-color: #FFFFFF;
  margin-top: 20rpx;
}

.media-grid {
  display: flex;
  flex-wrap: wrap;
}

.media-item {
  width: 200rpx;
  height: 200rpx;
  margin-right: 20rpx;
  margin-bottom: 20rpx;
  border-radius: 12rpx;
  overflow: hidden;
  position: relative;
}

.media-preview {
  width: 100%;
  height: 100%;
}

.media-delete {
  position: absolute;
  top: 0;
  right: 0;
  width: 44rpx;
  height: 44rpx;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 32rpx;
}

.add-media-btn {
  width: 200rpx;
  height: 200rpx;
  background-color: #F5F7FA;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #DDDDDD;
}

.add-icon {
  font-size: 64rpx;
  color: #999999;
  line-height: 1;
}

.add-text {
  font-size: 24rpx;
  color: #999999;
  margin-top: 8rpx;
}

/* 备注区域 */
.remark-section {
  padding: 30rpx;
  background-color: #FFFFFF;
  margin-top: 20rpx;
  position: relative;
}

.remark-input {
  width: 100%;
  min-height: 200rpx;
  padding: 20rpx;
  background-color: #F5F7FA;
  border-radius: 12rpx;
  font-size: 30rpx;
  line-height: 1.6;
}

.remark-count {
  position: absolute;
  bottom: 20rpx;
  right: 30rpx;
  font-size: 24rpx;
  color: #999999;
}

/* 宠龄显示 */
.pet-age-section {
  padding: 30rpx;
  margin-top: 20rpx;
}

.pet-age-badge {
  display: inline-flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background-color: #FFF7E6;
  border-radius: 40rpx;
}

.age-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.age-text {
  font-size: 26rpx;
  color: #996600;
}

/* 弹窗样式 */
.picker-modal,
.pet-picker-modal,
.media-picker-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  visibility: hidden;
  opacity: 0;
  transition: all 0.3s ease;
}

.picker-modal.show,
.pet-picker-modal.show,
.media-picker-modal.show {
  visibility: visible;
  opacity: 1;
}

.picker-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
}

.picker-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #FFFFFF;
  border-radius: 24rpx 24rpx 0 0;
  padding-bottom: env(safe-area-inset-bottom);
}

.picker-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  border-bottom: 1rpx solid #EEEEEE;
  font-size: 30rpx;
  color: #3366CC;
}

.picker-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

/* 日期选择器 */
.date-picker {
  height: 400rpx;
}

.picker-item {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

/* 宠物选择列表 */
.pet-picker-content {
  max-height: 70vh;
}

.pet-list {
  padding: 20rpx 30rpx;
  max-height: 500rpx;
  overflow-y: auto;
}

.pet-option {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  background-color: #F5F7FA;
}

.pet-option.active {
  background-color: #E6F0FF;
  border: 2rpx solid #3366CC;
}

.pet-option-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.pet-option-name {
  flex: 1;
  font-size: 30rpx;
  color: #333333;
}

.pet-option-check {
  font-size: 32rpx;
  color: #3366CC;
}

.pet-picker-footer {
  padding: 30rpx;
  text-align: center;
  border-top: 1rpx solid #EEEEEE;
  color: #3366CC;
  font-size: 30rpx;
}

/* 媒体选择弹窗 */
.media-options {
  display: flex;
  padding: 40rpx 60rpx;
}

.media-option {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx;
  background-color: #F5F7FA;
  border-radius: 16rpx;
  margin: 0 20rpx;
}

.media-option-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.media-option-text {
  font-size: 28rpx;
  color: #666666;
}

.media-picker-cancel {
  padding: 30rpx;
  text-align: center;
  color: #999999;
  font-size: 30rpx;
  border-top: 1rpx solid #EEEEEE;
}

/* 爪印记忆暖系主题覆盖 */
.container {
  background:
    radial-gradient(circle at 12% 4%, rgba(255, 194, 122, 0.2) 0, rgba(255, 194, 122, 0) 180rpx),
    linear-gradient(180deg, #FFF4E7 0%, #FFF9F1 52%, #F7F1E8 100%);
}

.nav-bar {
  border-bottom: none;
  background: rgba(255, 253, 248, 0.94);
  box-shadow: 0 6rpx 18rpx rgba(146, 103, 67, 0.07);
}

.date-section,
.pet-section,
.type-section,
.media-section,
.note-section,
.picker-content {
  margin: 24rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(240, 223, 200, 0.82);
  box-shadow: 0 10rpx 28rpx rgba(146, 103, 67, 0.08);
}

.nav-title,
.section-title,
.date-text,
.pet-name,
.picker-title,
.picker-item {
  color: #4B3B32;
}

.nav-save,
.date-selector,
.pet-card,
.type-tabs,
.preset-item,
.custom-form,
.icon-option,
.media-option {
  background-color: #FFF7EC;
}

.nav-save.active,
.type-tab.active {
  background: linear-gradient(135deg, #F7A45A 0%, #E87852 100%);
  color: #FFFFFF;
  box-shadow: 0 6rpx 14rpx rgba(232, 120, 82, 0.22);
}

.pet-card.active,
.preset-item.active,
.icon-option.active,
.pet-option.active {
  background-color: #FFF0DE;
  border-color: #E87852;
}

.preset-item.active .preset-name,
.pet-picker-footer,
.picker-header,
.pet-option-check {
  color: #D87545;
}

.picker-header,
.pet-picker-footer,
.media-picker-cancel {
  border-color: #F2E5D8;
}
