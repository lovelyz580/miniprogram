<!--detail.wxml-->
<view class="container">
  <!-- 顶部导航 -->
  <view class="nav-bar">
    <view class="nav-back" bindtap="goBack">
      <text class="back-icon">‹</text>
    </view>
    <view class="nav-actions">
      <view class="nav-action" bindtap="onShare">
        <text>📤</text>
      </view>
      <view class="nav-action" bindtap="showMoreActions">
        <text>⋯</text>
      </view>
    </view>
  </view>

  <!-- 预览模式标识 -->
  <view class="preview-badge" wx:if="{{isPreview}}">
    <text>预览模式</text>
  </view>

  <!-- 用户信息 -->
  <view class="user-section">
    <image class="user-avatar" src="{{record.avatarUrl || '/assets/images/default-avatar.png'}}" mode="aspectFill"></image>
    <view class="user-info">
      <text class="user-name">{{record.nickname || '神秘铲屎官'}}</text>
      <text class="record-time">{{record.createTime}}</text>
    </view>
    <view class="pet-badge" >
      <image class="pet-avatar" src="{{record.avatarUrl || '/assets/images/default-pet.png'}}" mode="aspectFill"></image>
      <text class="pet-name">{{record.petName}}</text>
    </view>
  </view>

  <!-- 内容区域 -->
  <view class="content-section">
	    <!-- 里程碑特殊标识 -->
			<view class="milestone-section" wx:if="{{recordType === 'milestone' && record}}">
      <view class="milestone-badge">
        <text class="milestone-icon">{{record.icon || '⭐'}}</text>
        <text class="milestone-name">{{record.milestoneName}}</text>
      </view>
      <view class="milestone-date-info">
        <text class="date-label">🎯 发生于</text>
        <text class="date-value">{{record.milestoneDate}}</text>
        <text class="age-label">，当时TA</text>
        <text class="age-value">{{record.petAgeAtDate}}</text>
      </view>
    </view>
    <!-- 心情标签 -->
    <view class="mood-tag" wx:if="{{record.moodTag}}">
      <text>{{record.moodTag}}</text>
    </view>

    <!-- 文字内容 -->
    <text class="content-text" wx:if="{{record.content}}">{{record.content}}</text>
		<text class="content-text" wx:if="{{record.description}}">{{record.description}}</text>

    <!-- 媒体展示 -->
    <view class="media-section" wx:if="{{record.mediaUrls && record.mediaUrls.length > 0}}">
      <view 
        class="media-item {{record.mediaUrls.length === 1 ? 'single' : ''}}"
        wx:for="{{record.mediaUrls}}"
        wx:key="index"
        wx:if="{{index < 9}}"
      >
        <video 
          wx:if="{{item.type === 'video'}}"
          src="{{item.url}}"
          class="media-video"
          poster="{{item.thumbnail}}"
          controls
        ></video>
        <image 
          wx:else
          src="{{item.url}}"
          mode="aspectFill"
          class="media-image"
          bindtap="previewMedia"
          data-index="{{index}}"
        ></image>
        <view class="video-play-icon" wx:if="{{item.type === 'video'}}">
          <text>▶</text>
        </view>
        <view class="media-more-overlay" wx:if="{{index === 8 && record.mediaUrls.length > 9}}">
          <text>+{{record.mediaUrls.length - 9}}</text>
        </view>
      </view>
    </view>

    <!-- 位置信息 -->
    <view class="location-info" wx:if="{{record.location}}">
      <text class="location-icon">📍</text>
      <text class="location-text">{{record.location}}</text>
    </view>

    <!-- 标签 -->
    <view class="tag-list" wx:if="{{record.recordType}}">
      <text class="tag-item" wx:if="{{record.recordType==1}}"># 心情气泡</text>
			<text class="tag-item" wx:if="{{record.recordType==2}}"># 日记</text>
    </view>
  </view>

  <!-- 互动区域 -->
  <!-- <view class="interaction-section">
    <view class="interaction-item" bindtap="toggleLike">
      <text class="interaction-icon {{record.isLiked ? 'active' : ''}}">{{record.isLiked ? '❤️' : '🤍'}}</text>
