</view>

<!-- 更多操作弹窗 -->
<view class="action-sheet {{showActionSheet ? 'show' : ''}}">
  <view class="action-mask" bindtap="hideActionSheet"></view>
  <view class="action-content">
    <view class="action-item"  wx:if="{{isOwner}}" bindtap="onEdit">
      <text class="action-icon">✏️</text>
      <text class="action-text">编辑</text>
    </view>
    <view class="action-item" bindtap="onCopyLink">
      <text class="action-icon">🔗</text>
      <text class="action-text">复制链接</text>
    </view>
    <view class="action-item" bindtap="onReport">
      <text class="action-icon">🚫</text>
      <text class="action-text">举报</text>
    </view>
    <view class="action-item danger" wx:if="{{isOwner}}" bindtap="onDelete">
      <text class="action-icon">🗑</text>
      <text class="action-text">删除</text>
    </view>
    <view class="action-cancel" bindtap="hideActionSheet">
      <text>取消</text>
    </view>
  </view>
</view>

<!-- 分享弹窗 -->
<view class="share-modal {{showShareModal ? 'show' : ''}}">
  <view class="share-mask" bindtap="hideShareModal"></view>
  <view class="share-content">
    <view class="share-header">
      <text>分享到</text>
    </view>
    <view class="share-options">
      <view class="share-option" bindtap="shareToFriend">
        <view class="share-icon">💬</view>
        <text>微信好友</text>
      </view>
      <view class="share-option" bindtap="shareToMoments">
        <view class="share-icon">🖼</view>
        <text>朋友圈</text>
      </view>
      <view class="share-option" bindtap="savePoster">
        <view class="share-icon">📱</view>
        <text>保存图片</text>
      </view>
    </view>
    <view class="share-cancel" bindtap="hideShareModal">
      <text>取消</text>
    </view>
  </view>
</view>
