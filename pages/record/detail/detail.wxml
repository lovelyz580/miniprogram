<!--detail.wxml-->
<view class="container">
  <!-- 顶部导航 -->
  <view class="nav-bar">
    <view class="nav-back" bindtap="goBack">
      <text class="back-icon">‹</text>
    </view>
    <view class="nav-actions">
      <view class="nav-action" bindtap="onShare">
        <text>📤</text>
      </view>
      <view class="nav-action" bindtap="showMoreActions">
        <text>⋯</text>
      </view>
    </view>
  </view>

  <!-- 预览模式标识 -->
  <view class="preview-badge" wx:if="{{isPreview}}">
    <text>预览模式</text>
  </view>

  <!-- 用户信息 -->
  <view class="user-section">
    <image class="user-avatar" src="{{record.avatarUrl || '/assets/images/default-avatar.png'}}" mode="aspectFill"></image>
    <view class="user-info">
      <text class="user-name">{{record.nickname || '神秘铲屎官'}}</text>
      <text class="record-time">{{record.createTime}}</text>
    </view>
    <view class="pet-badge">
      <image class="pet-avatar" src="{{record.petAvatarUrl || '/assets/images/default-pet.png'}}" mode="aspectFill"></image>
      <text class="pet-name">{{record.petName}}</text>
    </view>
  </view>

  <!-- 内容区域 -->
  <view class="content-section">
    <!-- 里程碑特殊标识 -->
    <view class="milestone-section" wx:if="{{recordType === 'milestone' && record}}">
      <view class="milestone-badge">
        <text class="milestone-icon">{{record.icon || '⭐'}}</text>
        <text class="milestone-name">{{record.milestoneName}}</text>
      </view>
      <view class="milestone-date-info">
        <text class="date-label">🎯 发生于</text>
        <text class="date-value">{{record.milestoneDate}}</text>
        <text class="age-label">，当时TA</text>
        <text class="age-value">{{record.petAgeAtDate}}</text>
      </view>
    </view>
    <!-- 心情标签 -->
    <view class="mood-tag" wx:if="{{record.moodTag}}">
      <text>{{record.moodTag}}</text>
    </view>

    <!-- 文字内容 -->
    <rich-text class="content-text content-rich" wx:if="{{record.isRichContent && record.content}}" nodes="{{record.content}}"></rich-text>
    <text class="content-text" wx:elif="{{record.content}}">{{record.content}}</text>
    <text class="content-text" wx:if="{{record.description && !record.content}}">{{record.description}}</text>

    <!-- 媒体展示 -->
    <view class="media-section" wx:if="{{record.mediaUrls && record.mediaUrls.length > 0}}">
      <view
        class="media-item {{record.mediaUrls.length === 1 ? 'single' : ''}}"
        wx:for="{{record.mediaUrls}}"
        wx:key="index"
        wx:if="{{index < 9}}"
      >
        <video
          wx:if="{{item.type === 'video'}}"
          src="{{item.url}}"
          class="media-video"
          poster="{{item.thumbnail}}"
          controls
        ></video>
        <image
          wx:else
          src="{{item.url}}"
          mode="{{record.mediaUrls.length === 1 ? 'widthFix' : 'aspectFill'}}"
          class="media-image"
          bindtap="previewMedia"
          data-index="{{index}}"
        ></image>
        <view class="video-play-icon" wx:if="{{item.type === 'video'}}">
          <text>▶</text>
        </view>
        <view class="media-more-overlay" wx:if="{{index === 8 && record.mediaUrls.length > 9}}">
          <text>+{{record.mediaUrls.length - 9}}</text>
        </view>
      </view>
    </view>

    <!-- 位置信息 -->
    <view class="location-info" wx:if="{{record.location}}">
      <text class="location-icon">📍</text>
      <text class="location-text">{{record.location}}</text>
    </view>

    <!-- 标签 -->
    <view class="tag-list" wx:if="{{record.recordType}}">
      <text class="tag-item" wx:if="{{record.recordType==1}}"># 心情气泡</text>
      <text class="tag-item" wx:if="{{record.recordType==2}}"># 日记</text>
    </view>
  </view>

  <!-- 隐藏的 Canvas，用于绘制海报 -->
  <canvas
    type="2d"
    id="posterCanvas"
    class="poster-canvas-hidden"
    style="width:{{posterW}}px; height:{{posterH}}px;"
  ></canvas>
</view>

<!-- 更多操作弹窗 -->
<view class="action-sheet {{showActionSheet ? 'show' : ''}}">
  <view class="action-mask" bindtap="hideActionSheet"></view>
  <view class="action-content">
    <!-- <view class="action-item" wx:if="{{isOwner}}" bindtap="onEdit">
      <text class="action-icon">✏️</text>
      <text class="action-text">编辑</text>
    </view> -->
    <!-- <view class="action-item" bindtap="onCopyLink">
      <text class="action-icon">🔗</text>
      <text class="action-text">复制链接</text>
    </view> -->
    <!-- <view class="action-item" bindtap="onReport">
      <text class="action-icon">🚫</text>
      <text class="action-text">举报</text>
    </view> -->
    <view class="action-item danger" wx:if="{{isOwner}}" bindtap="onDelete">
      <text class="action-icon">🗑</text>
      <text class="action-text">删除</text>
    </view>
    <view class="action-cancel" bindtap="hideActionSheet">
      <text>取消</text>
    </view>
  </view>
</view>

<!-- 分享弹窗 -->
<view class="share-modal {{showShareModal ? 'show' : ''}}">
  <view class="share-mask" bindtap="hideShareModal"></view>
  <view class="share-content">
    <!-- 顶部拖拽条 -->
    <view class="sheet-handle"></view>

    <!-- 标题行 -->
    <view class="share-header">
      <view class="share-header-left">
        <text class="share-title">分享记录</text>
        <text class="share-subtitle">让更多人看见这份温暖 🐾</text>
      </view>
      <view class="share-close-btn" bindtap="hideShareModal">
        <text class="share-close-icon">✕</text>
      </view>
    </view>

    <!-- 分享选项 -->
    <view class="share-options">
      <!-- 分享给好友 -->
      <button class="share-option share-btn-reset" open-type="share" bindtap="hideShareModal">
        <view class="share-icon-wrap share-icon-friend">
          <text class="share-icon-emoji">💬</text>
        </view>
        <text class="share-label">微信好友</text>
      </button>

      <!-- 分享朋友圈 -->
      <button class="share-option share-btn-reset" open-type="shareTimeline" bindtap="hideShareModal">
        <view class="share-icon-wrap share-icon-moments">
          <text class="share-icon-emoji">🌐</text>
        </view>
        <text class="share-label">朋友圈</text>
      </button>

      <!-- 生成海报 -->
      <view class="share-option" bindtap="savePoster">
        <view class="share-icon-wrap share-icon-poster">
          <text class="share-icon-emoji">🖼️</text>
        </view>
        <text class="share-label">生成海报</text>
      </view>

      <!-- 复制链接 -->
      <!-- <view class="share-option" bindtap="onCopyLinkFromShare">
        <view class="share-icon-wrap share-icon-link">
          <text class="share-icon-emoji">🔗</text>
        </view>
        <text class="share-label">复制链接</text>
      </view> -->
    </view>

    <!-- 取消按钮 -->
    <view class="share-cancel-btn" bindtap="hideShareModal">
      <text class="share-cancel-text">取消</text>
    </view>
  </view>
</view>

<!-- 海报预览弹窗 -->
<view class="poster-modal {{showPosterModal ? 'show' : ''}}">
  <view class="poster-mask" bindtap="hidePosterModal"></view>
  <view class="poster-modal-content">
    <!-- 标题 -->
    <view class="poster-modal-header">
      <text class="poster-modal-title">🎨 专属海报</text>
      <view class="poster-close" bindtap="hidePosterModal">
        <text>✕</text>
      </view>
    </view>

    <!-- 海报预览 -->
    <view class="poster-preview-wrap">
      <!-- 生成中状态 -->
      <view class="poster-generating" wx:if="{{posterGenerating}}">
        <view class="generating-spinner"></view>
        <text class="generating-text">正在生成海报...</text>
      </view>
      <!-- 海报图片 -->
      <image
        wx:if="{{posterTempPath && !posterGenerating}}"
        class="poster-preview-img"
        src="{{posterTempPath}}"
        mode="widthFix"
        show-menu-by-longpress="true"
      ></image>
    </view>

    <!-- 长按提示 -->
    <view class="poster-tip" wx:if="{{posterTempPath && !posterGenerating}}">
      <text class="tip-text">💡 长按图片可直接保存或分享</text>
    </view>

    <!-- 操作按钮 -->
    <view class="poster-actions" wx:if="{{posterTempPath && !posterGenerating}}">
      <view class="poster-btn save-btn" bindtap="savePosterToAlbum">
        <text class="poster-btn-icon">💾</text>
        <text class="poster-btn-text">保存相册</text>
      </view>
      <view class="poster-btn share-moments-btn" bindtap="sharePosterToMoments">
        <text class="poster-btn-icon">🌐</text>
        <text class="poster-btn-text">分享朋友圈</text>
      </view>
    </view>
  </view>
</view>
