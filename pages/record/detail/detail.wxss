/* detail.wxss */

/* 页面容器 */
.container {
  min-height: 100vh;
  background-color: #FFFBF5;
  padding-bottom: 120rpx;
}

/* 顶部导航栏 */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background-color: #FFFFFF;
  border-bottom: none;
  box-shadow: 0 4rpx 16rpx rgba(180, 160, 140, 0.06);
  z-index: 100;
}

.nav-back {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  font-size: 48rpx;
  color: #333333;
  font-weight: bold;
}

.nav-actions {
  display: flex;
  align-items: center;
}

.nav-action {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-left: 20rpx;
}

/* 预览标识 */
.preview-badge {
  position: fixed;
  top: 100rpx;
  left: 50%;
  transform: translateX(-50%);
  padding: 12rpx 32rpx;
  background: linear-gradient(135deg, #FFB74D 0%, #FF8A65 100%);
  color: #FFFFFF;
  font-size: 24rpx;
  border-radius: 32rpx;
  z-index: 100;
  box-shadow: 0 4rpx 12rpx rgba(255, 138, 101, 0.3);
}

/* 用户信息 */
.user-section {
  display: flex;
  align-items: center;
  padding: 120rpx 30rpx 30rpx;
  background: linear-gradient(180deg, #FFF9F5 0%, #FFFFFF 100%);
}

.user-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.user-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.user-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}

.record-time {
  font-size: 24rpx;
  color: #999999;
  margin-top: 4rpx;
}

.pet-badge {
  display: flex;
  align-items: center;
  padding: 10rpx 20rpx;
  background-color: #FFF0E5;
  border-radius: 32rpx;
}

.pet-avatar {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  margin-right: 10rpx;
}

.pet-name {
  font-size: 24rpx;
  color: #8C7A70;
  font-weight: 600;
}

/* 内容区域 */
.content-section {
  padding: 0 30rpx 30rpx;
  background-color: #FFFFFF;
}

/* 里程碑特殊标识 */
.milestone-section {
  background: linear-gradient(135deg, #FFB74D 0%, #FF8A65 100%);
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  color: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(255, 138, 101, 0.2);
}

.milestone-badge {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.milestone-icon {
  font-size: 48rpx;
  margin-right: 12rpx;
}

.milestone-name {
  font-size: 36rpx;
  font-weight: 600;
}

.milestone-date-info {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  opacity: 0.95;
  flex-wrap: wrap;
}

.date-label,
.age-label {
  margin-right: 8rpx;
}

.date-value,
.age-value {
  font-weight: 500;
}

.mood-tag {
  display: inline-block;
  padding: 8rpx 20rpx;
  background-color: #FFF0E5;
  color: #FF8A65;
  font-size: 24rpx;
  font-weight: 600;
  border-radius: 24rpx;
  margin-bottom: 20rpx;
}

.content-text {
  font-size: 32rpx;
  line-height: 1.8;
  color: #333333;
  display: block;
  white-space: pre-wrap;
}

/* 媒体展示 */
.media-section {
  display: flex;
  flex-wrap: wrap;
  margin-top: 24rpx;
}

.media-item {
  width: 220rpx;
  height: 220rpx;
  margin-right: 10rpx;
  margin-bottom: 10rpx;
  border-radius: 8rpx;
  overflow: hidden;
  position: relative;
}

.media-item.single {
  width: 100%;
  height: 400rpx;
}

.media-item:nth-child(3n) {
  margin-right: 0;
}

.media-image,
.media-video {
  width: 100%;
  height: 100%;
}

.video-play-icon {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 80rpx;
  height: 80rpx;
  background-color: rgba(0, 0, 0, 0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 32rpx;
}

.media-more-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 40rpx;
  font-weight: 600;
}

/* 位置信息 */
.location-info {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  padding: 16rpx 20rpx;
  background-color: #FFFBF5;
  border-radius: 16rpx;
}

.location-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.location-text {
  font-size: 26rpx;
  color: #666666;
}

/* 标签 */
.tag-list {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
}

.tag-item {
  font-size: 26rpx;
  color: #FF8A65;
  font-weight: 600;
  margin-right: 20rpx;
}

/* 操作弹窗遮罩 */
.action-sheet,
.share-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  visibility: hidden;
  opacity: 0;
  transition: opacity 0.3s ease, visibility 0.3s ease;
}

.action-sheet.show,
.share-modal.show {
  visibility: visible;
  opacity: 1;
}

.action-mask,
.share-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(92, 74, 66, 0.45);
  backdrop-filter: blur(4px);
}

/* 更多操作弹窗 */
.action-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #FFFBF5;
  border-radius: 40rpx 40rpx 0 0;
  padding-bottom: env(safe-area-inset-bottom);
  animation: slideUp 0.35s cubic-bezier(0.16, 1, 0.3, 1);
}

.action-item {
  display: flex;
  align-items: center;
  padding: 32rpx 40rpx;
  border-bottom: 1rpx solid #F5EFE9;
  transition: background-color 0.15s ease;
}

.action-item:active {
  background-color: #FFF9F5;
}

.action-item.danger .action-text {
  color: #FF4D4F;
}

.action-icon {
  font-size: 40rpx;
  margin-right: 24rpx;
  width: 48rpx;
  text-align: center;
}

.action-text {
  font-size: 32rpx;
  color: #4A3E38;
  font-weight: 500;
}

.action-cancel {
  padding: 32rpx;
  text-align: center;
  color: #A89F9A;
  font-size: 30rpx;
  font-weight: 600;
  margin-top: 12rpx;
}

/* ── 分享弹窗 ─────────────────────────────────────────── */
.share-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #FFFBF5;
  border-radius: 40rpx 40rpx 0 0;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  animation: slideUp 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  overflow: hidden;
}

/* 顶部拖拽条 */
.sheet-handle {
  width: 80rpx;
  height: 8rpx;
  background-color: #E6DFDA;
  border-radius: 4rpx;
  margin: 20rpx auto 0;
}

/* 标题行 */
.share-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 40rpx 24rpx;
}

.share-header-left {
  display: flex;
  flex-direction: column;
}

.share-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #5C4A42;
  line-height: 1.3;
}

.share-subtitle {
  font-size: 24rpx;
  color: #A89F9A;
  margin-top: 6rpx;
  font-weight: 400;
}

.share-close-btn {
  width: 56rpx;
  height: 56rpx;
  background-color: #F0E8E1;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.share-close-btn:active {
  background-color: #E6DFDA;
  transform: scale(0.95);
}

.share-close-icon {
  font-size: 24rpx;
  color: #8C7A70;
  font-weight: 600;
}

/* 分享选项网格 */
.share-options {
  display: flex;
  justify-content: space-around;
  padding: 20rpx 24rpx 36rpx;
}

.share-option {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  transition: transform 0.2s ease;
}

.share-option:active {
  transform: scale(0.92);
}

/* 消除 button 默认样式 */
.share-btn-reset {
  background: transparent;
  border: none;
  padding: 0;
  margin: 0;
  line-height: normal;
  border-radius: 0;
  box-shadow: none;
}

.share-btn-reset::after {
  border: none;
}

/* 图标容器 - 各自颜色 */
.share-icon-wrap {
  width: 112rpx;
  height: 112rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.share-icon-friend {
  background: linear-gradient(135deg, #E8F5E9 0%, #C8E6C9 100%);
  box-shadow: 0 6rpx 20rpx rgba(102, 187, 106, 0.2);
}

.share-icon-moments {
  background: linear-gradient(135deg, #E3F2FD 0%, #BBDEFB 100%);
  box-shadow: 0 6rpx 20rpx rgba(66, 165, 245, 0.2);
}

.share-icon-poster {
  background: linear-gradient(135deg, #FFF0E5 0%, #FFE0CC 100%);
  box-shadow: 0 6rpx 20rpx rgba(255, 138, 101, 0.2);
}

.share-icon-link {
  background: linear-gradient(135deg, #F3E5F5 0%, #E1BEE7 100%);
  box-shadow: 0 6rpx 20rpx rgba(171, 71, 188, 0.15);
}

.share-icon-emoji {
  font-size: 52rpx;
  line-height: 1;
}

.share-label {
  font-size: 26rpx;
  color: #5C4A42;
  font-weight: 600;
  text-align: center;
}

/* 取消按钮 */
.share-cancel-btn {
  margin: 0 30rpx;
  padding: 28rpx;
  background-color: #F5EFE9;
  border-radius: 50rpx;
  text-align: center;
  transition: all 0.2s ease;
}

.share-cancel-btn:active {
  background-color: #EDE5DE;
  transform: scale(0.99);
}

.share-cancel-text {
  font-size: 30rpx;
  color: #8C7A70;
  font-weight: 700;
}

/* 海报 canvas（隐藏，仅用于绘制） */
.poster-canvas-hidden {
  position: fixed;
  top: -9999px;
  left: -9999px;
  opacity: 0;
  pointer-events: none;
}

/* 海报预览弹窗 */
.poster-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 2000;
  visibility: hidden;
  opacity: 0;
  transition: all 0.3s ease;
}

.poster-modal.show {
  visibility: visible;
  opacity: 1;
}

.poster-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(92, 74, 66, 0.6);
  backdrop-filter: blur(6px);
}

.poster-modal-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #FFFBF5;
  border-radius: 40rpx 40rpx 0 0;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  max-height: 92vh;
  overflow-y: auto;
  animation: slideUp 0.4s cubic-bezier(0.16, 1, 0.3, 1);
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.poster-modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 36rpx 40rpx 24rpx;
}

.poster-modal-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #5C4A42;
}

.poster-close {
  width: 60rpx;
  height: 60rpx;
  background-color: #F0E8E1;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #8C7A70;
  transition: all 0.2s ease;
}

.poster-close:active {
  transform: scale(0.95);
  background-color: #E6DFDA;
}

/* 海报预览区 */
.poster-preview-wrap {
  margin: 0 30rpx 24rpx;
  min-height: 300rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #F5F0EB;
  border-radius: 28rpx;
  overflow: hidden;
}

.poster-preview-img {
  width: 100%;
  display: block;
  border-radius: 28rpx;
}

/* 生成中状态 */
.poster-generating {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}

.generating-spinner {
  width: 80rpx;
  height: 80rpx;
  border: 6rpx solid #FFE0CC;
  border-top-color: #FF8A65;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 28rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.generating-text {
  font-size: 28rpx;
  color: #A89F9A;
  font-weight: 600;
}

/* 长按提示 */
.poster-tip {
  margin: 0 30rpx 24rpx;
  padding: 20rpx 28rpx;
  background: linear-gradient(135deg, #FFF9E6 0%, #FFF3D4 100%);
  border-radius: 20rpx;
  border-left: 6rpx solid #FFD54F;
}

.tip-text {
  font-size: 26rpx;
  color: #8C6A30;
  font-weight: 500;
}

/* 海报操作按钮 */
.poster-actions {
  display: flex;
  gap: 24rpx;
  padding: 0 30rpx;
}

.poster-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx 0;
  border-radius: 50rpx;
  transition: all 0.2s ease;
}

.poster-btn:active {
  transform: scale(0.98);
}

.save-btn {
  background: linear-gradient(135deg, #FFB74D 0%, #FF8A65 100%);
  box-shadow: 0 8rpx 24rpx rgba(255, 138, 101, 0.3);
}

.share-moments-btn {
  background: linear-gradient(135deg, #66BB6A 0%, #4CAF50 100%);
  box-shadow: 0 8rpx 24rpx rgba(102, 187, 106, 0.3);
}

.poster-btn-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.poster-btn-text {
  font-size: 30rpx;
  font-weight: 700;
  color: #FFFFFF;
}
