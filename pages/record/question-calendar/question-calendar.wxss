/* question-calendar.wxss */
/* 问答日历页面样式 */

.container {
  min-height: 100vh;
  background-color: #F5F7FA;
  padding-bottom: calc(300rpx + env(safe-area-inset-bottom));
}

/* 顶部标题 */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 40rpx 30rpx;
  background: linear-gradient(135deg, #3366CC 0%, #6699FF 100%);
  color: #FFFFFF;
}

.header-content {
  display: flex;
  align-items: center;
  min-width: 0;
}

.header-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  background-color: rgba(255, 255, 255, 0.22);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.header-icon {
  font-size: 48rpx;
  line-height: 1;
}

.header-text {
  display: flex;
  flex-direction: column;
}

.header-title {
  font-size: 40rpx;
  font-weight: 700;
}

.header-subtitle {
  font-size: 24rpx;
  opacity: 0.8;
  margin-top: 4rpx;
}

.pet-picker {
  display: flex;
  align-items: center;
  background-color: rgba(255, 255, 255, 0.2);
  padding: 12rpx 20rpx;
  border-radius: 32rpx;
}

.pet-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  margin-right: 12rpx;
}

.pet-name {
  font-size: 26rpx;
  margin-right: 8rpx;
}

.arrow {
  font-size: 20rpx;
  opacity: 0.8;
}

/* 月度统计 */
.month-stats {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30rpx;
  background-color: #FFFFFF;
  margin: 24rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.stat-value {
  font-size: 48rpx;
  font-weight: 700;
  color: #3366CC;
}

.stat-label {
  font-size: 24rpx;
  color: #999999;
  margin-top: 8rpx;
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background-color: #EEEEEE;
}

/* 日历区域 */
.calendar-section {
  background-color: #FFFFFF;
  margin: 0 24rpx;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

/* 月份切换 */
.month-switch {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 30rpx;
}

.switch-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #F5F7FA;
  border-radius: 50%;
}

.switch-icon {
  font-size: 40rpx;
  color: #3366CC;
  font-weight: bold;
}

.month-text {
  font-size: 34rpx;
  font-weight: 600;
  color: #333333;
}

/* 星期标题 */
.week-header {
  display: flex;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.week-item {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #999999;
}

/* 日历主体 */
.calendar-body {
  display: flex;
  flex-wrap: wrap;
}

.calendar-day {
  width: 14.28%;
  height: 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
}

.day-number {
  font-size: 28rpx;
  color: #333333;
}

.calendar-day.not-current .day-number {
  color: #DDDDDD;
}

.calendar-day.today .day-number {
  color: #3366CC;
  font-weight: 600;
}

.calendar-day.selected {
  background-color: #E6F0FF;
  border-radius: 50%;
}

.calendar-day.today.selected {
  background-color: #3366CC;
}

.calendar-day.today.selected .day-number {
  color: #FFFFFF;
}

/* 回答记录标记 */
.answer-dot {
  width: 16rpx;
  height: 16rpx;
  background-color: #52C41A;
  border-radius: 50%;
  margin-top: 4rpx;
}

.calendar-day.today .answer-dot {
  background-color: #3366CC;
}

.calendar-day.today.selected .answer-dot {
  background-color: #FFFFFF;
}

/* 日历说明 */
.calendar-tip {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 40rpx;
  margin-top: 30rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #F0F0F0;
}

.tip-item {
  display: flex;
  align-items: center;
}

.tip-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 10rpx;
}

.tip-dot.today {
  background-color: #3366CC;
}

.tip-dot.answered {
  background-color: #52C41A;
}

.tip-text {
  font-size: 22rpx;
  color: #999999;
}

/* 回答列表区域 */
.answers-section {
  margin: 24rpx;
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}

.answer-count {
  font-size: 24rpx;
  color: #999999;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
}

.empty-btn {
  margin-top: 20rpx;
  padding: 16rpx 40rpx;
  background-color: #3366CC;
  border-radius: 32rpx;
}

.empty-btn text {
  color: #FFFFFF;
  font-size: 26rpx;
}

/* 回答列表 */
.answer-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.answer-item {
  padding: 24rpx;
  background-color: #F9F9F9;
  border-radius: 12rpx;
}

.answer-question {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.question-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.question-text {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.5;
  flex: 1;
}

.answer-content {
  padding-left: 40rpx;
}

.content-text {
  font-size: 28rpx;
  color: #333333;
  line-height: 1.6;
}

.answer-images {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
  margin-left: 40rpx;
  gap: 12rpx;
}

.answer-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 8rpx;
}

/* 底部导航（与今日问答入口同级） */
.qa-nav-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background-color: #F5F7FA;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.qa-nav-inner {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.qa-nav-row {
  display: flex;
  align-items: center;
  padding: 24rpx 24rpx 24rpx 0;
  background-color: #FFFFFF;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  overflow: hidden;
}

.qa-nav-accent {
  width: 8rpx;
  align-self: stretch;
  flex-shrink: 0;
  background-color: #3366CC;
  border-radius: 0 4rpx 4rpx 0;
  margin-right: 16rpx;
}

.qa-nav-body {
  flex: 1;
  display: flex;
  align-items: center;
  min-width: 0;
}

.qa-nav-row:not(.qa-nav-row--primary) .qa-nav-body {
  padding-left: 24rpx;
}

.qa-nav-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  background-color: #E6F0FF;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.qa-nav-icon {
  font-size: 44rpx;
  line-height: 1;
}

.qa-nav-text-col {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}

.qa-nav-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}

.qa-nav-desc {
  font-size: 24rpx;
  color: #999999;
  margin-top: 4rpx;
}

.qa-nav-arrow {
  font-size: 36rpx;
  color: #CCCCCC;
  padding-right: 8rpx;
  flex-shrink: 0;
}
