/* question-calendar.wxss */
/* 问答日历页面样式 */

.container {
  min-height: 100vh;
  background-color: #FFFBF5; /* 温暖奶油底色 */
  padding-bottom: calc(300rpx + env(safe-area-inset-bottom));
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, Segoe UI, Arial, Roboto, 'PingFang SC', 'miui', 'Hiragino Sans GB', 'Microsoft Yahei', sans-serif;
}

/* 顶部标题 */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 40rpx 30rpx 30rpx;
  background: linear-gradient(135deg, #FFB74D 0%, #FF8A65 100%);
  color: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(255, 138, 101, 0.15);
}

.header-content {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.header-icon-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  background-color: rgba(255, 255, 255, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.header-icon {
  font-size: 52rpx;
  line-height: 1;
}

.header-text {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}

.header-title {
  font-size: 42rpx;
  font-weight: 800;
  margin-bottom: 6rpx;
  letter-spacing: 0.5rpx;
}

.header-subtitle {
  font-size: 24rpx;
  opacity: 0.9;
  font-weight: 400;
}

.pet-picker {
  display: flex;
  align-items: center;
  background-color: rgba(255, 255, 255, 0.25);
  padding: 12rpx 20rpx;
  border-radius: 50rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  transition: all 0.2s ease;
}

.pet-picker:active {
  transform: scale(0.98);
}

.pet-avatar {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  margin-right: 12rpx;
  border: 3rpx solid #FFFFFF;
}

.pet-name {
  font-size: 26rpx;
  margin-right: 8rpx;
  font-weight: 600;
}

.arrow {
  font-size: 20rpx;
  opacity: 0.9;
}

/* 月度统计 */
.month-stats {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 36rpx;
  background-color: #FFFFFF;
  margin: 24rpx 30rpx;
  border-radius: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(180, 160, 140, 0.1);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.stat-value {
  font-size: 56rpx;
  font-weight: 800;
  color: #FF8A65;
  line-height: 1;
  margin-bottom: 12rpx;
}

.stat-label {
  font-size: 26rpx;
  color: #A89F9A;
  font-weight: 600;
}

.stat-divider {
  width: 2rpx;
  height: 70rpx;
  background: linear-gradient(180deg, transparent 0%, #F0E8E1 50%, transparent 100%);
}

/* 日历区域 */
.calendar-section {
  background-color: #FFFFFF;
  margin: 0 30rpx 24rpx;
  border-radius: 32rpx;
  padding: 36rpx;
  box-shadow: 0 8rpx 24rpx rgba(180, 160, 140, 0.1);
}

/* 月份切换 */
.month-switch {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 36rpx;
}

.switch-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #FFF0E5 0%, #FFE6D6 100%);
  border-radius: 50%;
  transition: all 0.2s ease;
  box-shadow: 0 4rpx 12rpx rgba(255, 138, 101, 0.1);
}

.switch-btn:active {
  transform: scale(0.95);
  background: linear-gradient(135deg, #FFE6D6 0%, #FFDAB9 100%);
}

.switch-icon {
  font-size: 44rpx;
  color: #FF8A65;
  font-weight: 700;
}

.month-text {
  font-size: 36rpx;
  font-weight: 800;
  color: #5C4A42;
}

/* 星期标题 */
.week-header {
  display: flex;
  padding-bottom: 24rpx;
  margin-bottom: 12rpx;
  border-bottom: 2rpx dashed #F0E8E1;
}

.week-item {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #A89F9A;
  font-weight: 600;
}

/* 日历主体 */
.calendar-body {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 0;
}

.calendar-day {
  width: 14.28%;
  height: 88rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  transition: all 0.2s ease;
  border-radius: 16rpx;
}

.calendar-day:active {
  transform: scale(0.95);
}

.day-number {
  font-size: 30rpx;
  color: #4A3E38;
  font-weight: 500;
}

.calendar-day.not-current .day-number {
  color: #E6DFDA;
}

.calendar-day.today .day-number {
  color: #FF8A65;
  font-weight: 800;
}

.calendar-day.selected {
  background: linear-gradient(135deg, #FFF0E5 0%, #FFE6D6 100%);
  box-shadow: 0 4rpx 12rpx rgba(255, 138, 101, 0.15);
}

.calendar-day.today.selected {
  background: linear-gradient(135deg, #FFB74D 0%, #FF8A65 100%);
}

.calendar-day.today.selected .day-number {
  color: #FFFFFF;
}

/* 回答记录标记 */
.answer-dot {
  width: 12rpx;
  height: 12rpx;
  background-color: #66BB6A;
  border-radius: 50%;
  margin-top: 6rpx;
  box-shadow: 0 2rpx 6rpx rgba(102, 187, 106, 0.3);
}

.calendar-day.has-answer {
  position: relative;
}

.calendar-day.has-answer::after {
  content: '';
  position: absolute;
  bottom: 8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 6rpx;
  height: 6rpx;
  background-color: #66BB6A;
  border-radius: 50%;
}

.calendar-day.today .answer-dot {
  background-color: #FF8A65;
}

.calendar-day.today.selected .answer-dot {
  background-color: #FFFFFF;
}

/* 日历说明 */
.calendar-tip {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 48rpx;
  margin-top: 32rpx;
  padding-top: 28rpx;
  border-top: 2rpx dashed #F0E8E1;
}

.tip-item {
  display: flex;
  align-items: center;
}

.tip-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  margin-right: 12rpx;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.1);
}

.tip-dot.today {
  background-color: #FF8A65;
}

.tip-dot.answered {
  background-color: #66BB6A;
}

.tip-text {
  font-size: 24rpx;
  color: #A89F9A;
  font-weight: 600;
}

/* 回答列表区域 */
.answers-section {
  margin: 0 30rpx 24rpx;
  background-color: #FFFFFF;
  border-radius: 32rpx;
  padding: 36rpx;
  box-shadow: 0 8rpx 24rpx rgba(180, 160, 140, 0.1);
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
  padding-bottom: 24rpx;
  border-bottom: 2rpx dashed #F0E8E1;
}

.section-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #5C4A42;
}

.answer-count {
  font-size: 24rpx;
  color: #FF8A65;
  font-weight: 700;
  background-color: #FFF0E5;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
}

.empty-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
  opacity: 0.8;
}

.empty-text {
  font-size: 30rpx;
  color: #A89F9A;
  font-weight: 600;
}

.empty-btn {
  margin-top: 28rpx;
  padding: 20rpx 48rpx;
  background: linear-gradient(135deg, #FFB74D 0%, #FF8A65 100%);
  border-radius: 50rpx;
  box-shadow: 0 6rpx 20rpx rgba(255, 138, 101, 0.3);
  transition: all 0.2s ease;
}

.empty-btn:active {
  transform: scale(0.98);
}

.empty-btn text {
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 700;
}

/* 回答列表 */
.answer-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.answer-item {
  padding: 28rpx;
  background: linear-gradient(135deg, #FFFBF5 0%, #FFF9F0 100%);
  border-radius: 24rpx;
  border: 2rpx solid #FFF0E5;
  transition: all 0.2s ease;
}

.answer-item:active {
  transform: scale(0.99);
  background: linear-gradient(135deg, #FFF9F0 0%, #FFF0E5 100%);
}

.answer-question {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx dashed #FFF0E5;
}

.question-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.question-text {
  font-size: 28rpx;
  color: #8C7A70;
  line-height: 1.6;
  flex: 1;
  font-weight: 600;
}

.answer-content {
  padding-left: 48rpx;
}

.content-text {
  font-size: 30rpx;
  color: #4A3E38;
  line-height: 1.7;
  font-weight: 500;
}

.answer-images {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
  margin-left: 48rpx;
  gap: 16rpx;
}

.answer-image {
  width: 140rpx;
  height: 140rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(180, 160, 140, 0.1);
}

/* 底部导航（与今日问答入口同级） */
.qa-nav-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background-color: #F5F7FA;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.qa-nav-inner {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.qa-nav-row {
  display: flex;
  align-items: center;
  padding: 24rpx 24rpx 24rpx 0;
  background-color: #FFFFFF;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  overflow: hidden;
}

.qa-nav-accent {
  width: 8rpx;
  align-self: stretch;
  flex-shrink: 0;
  background-color: #3366CC;
  border-radius: 0 4rpx 4rpx 0;
  margin-right: 16rpx;
}

.qa-nav-body {
  flex: 1;
  display: flex;
  align-items: center;
  min-width: 0;
}

.qa-nav-row:not(.qa-nav-row--primary) .qa-nav-body {
  padding-left: 24rpx;
}

.qa-nav-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  background-color: #E6F0FF;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.qa-nav-icon {
  font-size: 44rpx;
  line-height: 1;
}

.qa-nav-text-col {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}

.qa-nav-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}

.qa-nav-desc {
  font-size: 24rpx;
  color: #999999;
  margin-top: 4rpx;
}

.qa-nav-arrow {
  font-size: 36rpx;
  color: #CCCCCC;
  padding-right: 8rpx;
  flex-shrink: 0;
}

