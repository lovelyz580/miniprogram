/* daily-question.wxss */

/* 页面容器 */
.container {
  min-height: 100vh;
  background-color: #FFFBF5; /* 温暖奶油底色 */
  padding-bottom: 40rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, Segoe UI, Arial, Roboto, 'PingFang SC', 'miui', 'Hiragino Sans GB', 'Microsoft Yahei', sans-serif;
}

/* 顶部标题 */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 40rpx 30rpx 30rpx;
  background: linear-gradient(135deg, #FFB74D 0%, #FF8A65 100%);
  color: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(255, 138, 101, 0.15);
  position: relative;
}

.header-content {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.header-icon-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  background-color: rgba(255, 255, 255, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.header-icon {
  font-size: 52rpx;
  line-height: 1;
}

.header-text {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}

.header-title {
  font-size: 42rpx;
  font-weight: 800;
  margin-bottom: 6rpx;
  letter-spacing: 0.5rpx;
}

.header-subtitle {
  font-size: 24rpx;
  opacity: 0.9;
  font-weight: 400;
}

.header-pet {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  overflow: hidden;
  background-color: #FFFFFF;
  padding: 4rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.15);
  flex-shrink: 0;
}

.pet-avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

/* 日期标签 */
.date-tag {
  display: inline-flex;
  align-items: center;
  margin: 24rpx 30rpx 0;
  padding: 12rpx 24rpx;
  background-color: #FFFFFF;
  border-radius: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(180, 160, 140, 0.08);
}

.date-icon {
  font-size: 28rpx;
  margin-right: 10rpx;
}

.date-text {
  font-size: 26rpx;
  color: #5C4A42;
  font-weight: 600;
}

/* 问题卡片 */
.question-card {
  margin: 24rpx 30rpx;
  padding: 40rpx;
  background-color: #FFFFFF;
  border-radius: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(180, 160, 140, 0.1);
  position: relative;
  overflow: hidden;
}

.question-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 8rpx;
  background: linear-gradient(90deg, #FFB74D 0%, #FF8A65 100%);
}

.question-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.question-type {
  flex: 1;
}

.type-tag {
  display: inline-block;
  padding: 10rpx 24rpx;
  background-color: #FFF0E5;
  color: #FF8A65;
  font-size: 24rpx;
  font-weight: 700;
  border-radius: 30rpx;
}

.question-number {
  font-size: 24rpx;
  color: #BDB3AC;
  font-weight: 500;
}

.question-content {
  position: relative;
  padding: 20rpx 0;
}

.question-mark {
  font-size: 56rpx;
  color: #FFDAB9;
  font-weight: 800;
  line-height: 1;
  font-family: Georgia, serif;
}

.question-text {
  display: block;
  font-size: 36rpx;
  line-height: 1.7;
  color: #4A3E38;
  font-weight: 600;
  margin: 16rpx 0;
  letter-spacing: 0.5rpx;
}

.question-tip {
  margin-top: 28rpx;
  padding: 20rpx 24rpx;
  background: linear-gradient(135deg, #FFF9E6 0%, #FFF3D4 100%);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  border-left: 6rpx solid #FFD54F;
}

.tip-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.tip-text {
  font-size: 26rpx;
  color: #8C6A30;
  line-height: 1.5;
  font-weight: 500;
}

/* 回答区域 */
.answer-section {
  margin: 0 30rpx 24rpx;
  background-color: #FFFFFF;
  border-radius: 32rpx;
  padding: 36rpx;
  box-shadow: 0 8rpx 24rpx rgba(180, 160, 140, 0.1);
}

.answer-input {
  width: 100%;
  min-height: 280rpx;
  font-size: 32rpx;
  line-height: 1.8;
  color: #4A3E38;
  background-color: #FFFBF5;
  padding: 24rpx;
  border-radius: 20rpx;
  border: 2rpx solid #F0E8E1;
}

.answer-footer {
  display: flex;
  justify-content: flex-end;
  padding-top: 20rpx;
}

.word-count {
  font-size: 24rpx;
  color: #BDB3AC;
  font-weight: 500;
}

/* 图片区域 */
.image-section {
  margin-top: 32rpx;
}

.image-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.section-label {
  font-size: 30rpx;
  color: #5C4A42;
  font-weight: 700;
}

.image-tip {
  font-size: 24rpx;
  color: #A89F9A;
  font-weight: 500;
}

.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-item {
  width: 180rpx;
  height: 180rpx;
  border-radius: 20rpx;
  overflow: hidden;
  position: relative;
  box-shadow: 0 4rpx 12rpx rgba(180, 160, 140, 0.1);
}

.image-preview {
  width: 100%;
  height: 100%;
}

.image-delete {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 48rpx;
  height: 48rpx;
  background-color: rgba(92, 74, 66, 0.8);
  backdrop-filter: blur(4rpx);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 300;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
}

.add-image-btn {
  width: 180rpx;
  height: 180rpx;
  background-color: #FFFBF5;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 3rpx dashed #FFDAB9;
  transition: all 0.2s ease;
}

.add-image-btn:active {
  background-color: #FFF0E5;
  transform: scale(0.98);
}

.add-icon {
  font-size: 64rpx;
  color: #FF8A65;
  line-height: 1;
  font-weight: 300;
}

.add-text {
  font-size: 24rpx;
  color: #A89F9A;
  margin-top: 12rpx;
  font-weight: 500;
}

/* 提交按钮 */
.submit-btn {
  margin-top: 36rpx;
  padding: 32rpx;
  background-color: #E6DFDA;
  color: #BDB3AC;
  text-align: center;
  border-radius: 50rpx;
  font-size: 34rpx;
  font-weight: 700;
  transition: all 0.3s ease;
  box-shadow: 0 4rpx 12rpx rgba(180, 160, 140, 0.1);
}

.submit-btn.active {
  background: linear-gradient(135deg, #FFB74D 0%, #FF8A65 100%);
  color: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(255, 138, 101, 0.3);
}

.submit-btn.active:active {
  transform: scale(0.98);
}

/* 已回答状态 */
.answered-section {
  margin: 24rpx 30rpx;
}

.answered-card {
  background-color: #FFFFFF;
  border-radius: 32rpx;
  padding: 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(180, 160, 140, 0.1);
  position: relative;
  overflow: hidden;
}

.answered-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 8rpx;
  background: linear-gradient(90deg, #81C784 0%, #66BB6A 100%);
}

.answered-badge {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 24rpx;
  background: linear-gradient(135deg, #E8F5E9 0%, #C8E6C9 100%);
  border-radius: 30rpx;
  margin-bottom: 28rpx;
}

.badge-icon {
  font-size: 28rpx;
  color: #4CAF50;
  margin-right: 10rpx;
  font-weight: 700;
}

.badge-text {
  font-size: 26rpx;
  color: #4CAF50;
  font-weight: 700;
}

.answered-question {
  font-size: 28rpx;
  color: #A89F9A;
  display: block;
  margin-bottom: 24rpx;
  line-height: 1.5;
  font-weight: 500;
}

.answered-text {
  font-size: 32rpx;
  line-height: 1.8;
  color: #4A3E38;
  display: block;
  font-weight: 500;
}

.answered-images {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 28rpx;
}

.answered-image {
  width: 180rpx;
  height: 180rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(180, 160, 140, 0.1);
}

.answered-time {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 2rpx dashed #F0E8E1;
}

.answered-time text {
  font-size: 26rpx;
  color: #BDB3AC;
  font-weight: 500;
}

/* 换一个按钮 */
.change-btn {
  margin-top: 24rpx;
  padding: 28rpx;
  background-color: #FFFFFF;
  border-radius: 50rpx;
  text-align: center;
  border: 3rpx solid #FF8A65;
  transition: all 0.2s ease;
  box-shadow: 0 4rpx 12rpx rgba(180, 160, 140, 0.08);
}

.change-btn:active {
  background-color: #FFF9F5;
  transform: scale(0.98);
}

.change-btn text {
  font-size: 30rpx;
  color: #FF8A65;
  font-weight: 700;
}

/* 快捷入口 */
.quick-nav {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin: 24rpx 30rpx;
}

.nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 20rpx;
  background-color: #FFFFFF;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(180, 160, 140, 0.08);
  transition: all 0.2s ease;
  position: relative;
}

.nav-item:active {
  transform: scale(0.98);
  background-color: #FFF9F5;
}

.nav-icon-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #FFF0E5 0%, #FFE6D6 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 138, 101, 0.1);
}

.nav-icon {
  font-size: 52rpx;
  line-height: 1;
}

.nav-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.nav-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #5C4A42;
  margin-bottom: 8rpx;
}

.nav-desc {
  font-size: 24rpx;
  color: #A89F9A;
  font-weight: 500;
}

.nav-arrow {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  font-size: 32rpx;
  color: #D1C9C4;
  font-weight: 300;
}

/* 统计区域 */
.stats-section {
  margin: 24rpx 30rpx;
  background-color: #FFFFFF;
  border-radius: 32rpx;
  padding: 36rpx;
  box-shadow: 0 8rpx 24rpx rgba(180, 160, 140, 0.1);
}

.stats-header {
  margin-bottom: 28rpx;
}

.stats-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #5C4A42;
  position: relative;
  display: inline-block;
}

.stats-title::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 10rpx;
  background-color: #FFDAB9;
  border-radius: 5rpx;
  z-index: -1;
  transform: translateY(-6rpx);
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

.stats-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 20rpx;
  background: linear-gradient(135deg, #FFFBF5 0%, #FFF9F0 100%);
  border-radius: 24rpx;
  border: 2rpx solid #FFF0E5;
  transition: all 0.2s ease;
}

.stats-card:active {
  transform: scale(0.98);
  background: linear-gradient(135deg, #FFF9F0 0%, #FFF0E5 100%);
}

.stats-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.stats-number {
  font-size: 52rpx;
  font-weight: 800;
  color: #FF8A65;
  margin-bottom: 8rpx;
  line-height: 1;
}

.stats-label {
  font-size: 24rpx;
  color: #A89F9A;
  font-weight: 600;
}
