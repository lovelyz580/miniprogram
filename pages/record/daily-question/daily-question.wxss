/* daily-question.wxss */

/* 页面容器 */
.container {
  min-height: 100vh;
  background-color: #F5F7FA;
  padding-bottom: 40rpx;
}

/* 顶部标题 */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 40rpx 30rpx;
  background: linear-gradient(135deg, #3366CC 0%, #6699FF 100%);
  color: #FFFFFF;
}

.header-content {
  display: flex;
  align-items: center;
}

.header-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  background-color: rgba(255, 255, 255, 0.22);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.header-icon {
  font-size: 48rpx;
  line-height: 1;
}

.header-text {
  display: flex;
  flex-direction: column;
}

.header-title {
  font-size: 40rpx;
  font-weight: 700;
}

.header-date {
  font-size: 24rpx;
  opacity: 0.8;
  margin-top: 4rpx;
}

.header-pet {
  display: flex;
  align-items: center;
  background-color: rgba(255, 255, 255, 0.2);
  padding: 12rpx 20rpx;
  border-radius: 32rpx;
}

.pet-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  margin-right: 12rpx;
}

.pet-name {
  font-size: 26rpx;
  font-weight: 500;
}

/* 问题卡片 */
.question-card {
  margin: 30rpx;
  padding: 40rpx;
  background-color: #FFFFFF;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.question-type {
  margin-bottom: 20rpx;
}

.type-tag {
  display: inline-block;
  padding: 8rpx 20rpx;
  background-color: #E6F0FF;
  color: #3366CC;
  font-size: 22rpx;
  border-radius: 24rpx;
}

.question-text {
  font-size: 34rpx;
  line-height: 1.6;
  color: #333333;
  font-weight: 500;
}

.question-tip {
  margin-top: 24rpx;
  padding: 16rpx 20rpx;
  background-color: #FFF9E6;
  border-radius: 12rpx;
}

.question-tip text {
  font-size: 24rpx;
  color: #996600;
}

/* 回答区域 */
.answer-section {
  margin: 0 30rpx;
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.answer-input {
  width: 100%;
  min-height: 240rpx;
  font-size: 30rpx;
  line-height: 1.8;
  color: #333333;
}

.answer-footer {
  display: flex;
  justify-content: flex-end;
  padding-top: 16rpx;
  border-top: 1rpx solid #EEEEEE;
}

.word-count {
  font-size: 24rpx;
  color: #999999;
}

/* 图片区域 */
.image-section {
  margin-top: 30rpx;
}

.image-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-label {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
}

.image-tip {
  font-size: 24rpx;
  color: #999999;
}

.image-grid {
  display: flex;
  flex-wrap: wrap;
}

.image-item {
  width: 180rpx;
  height: 180rpx;
  margin-right: 20rpx;
  margin-bottom: 20rpx;
  border-radius: 12rpx;
  overflow: hidden;
  position: relative;
}

.image-preview {
  width: 100%;
  height: 100%;
}

.image-delete {
  position: absolute;
  top: 0;
  right: 0;
  width: 40rpx;
  height: 40rpx;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 28rpx;
}

.add-image-btn {
  width: 180rpx;
  height: 180rpx;
  background-color: #F5F7FA;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #DDDDDD;
}

.add-icon {
  font-size: 56rpx;
  color: #999999;
  line-height: 1;
}

.add-text {
  font-size: 22rpx;
  color: #999999;
  margin-top: 8rpx;
}

/* 提交按钮 */
.submit-btn {
  margin-top: 30rpx;
  padding: 28rpx;
  background-color: #E6E6E6;
  color: #999999;
  text-align: center;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.submit-btn.active {
  background-color: #3366CC;
  color: #FFFFFF;
}

/* 已回答状态 */
.answered-section {
  margin: 30rpx;
}

.answered-card {
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 40rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.answered-badge {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 20rpx;
  background-color: #E6F7E6;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
}

.badge-icon {
  font-size: 24rpx;
  color: #52C41A;
  margin-right: 8rpx;
}

.badge-text {
  font-size: 24rpx;
  color: #52C41A;
}

.answered-question {
  font-size: 26rpx;
  color: #999999;
  display: block;
  margin-bottom: 20rpx;
}

.answered-text {
  font-size: 30rpx;
  line-height: 1.8;
  color: #333333;
  display: block;
}

.answered-images {
  display: flex;
  flex-wrap: wrap;
  margin-top: 24rpx;
}

.answered-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  margin-right: 16rpx;
  margin-bottom: 16rpx;
}

.answered-time {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #EEEEEE;
}

.answered-time text {
  font-size: 24rpx;
  color: #999999;
}

/* 换一个按钮 */
.change-btn {
  margin-top: 24rpx;
  padding: 24rpx;
  background-color: #FFFFFF;
  border-radius: 16rpx;
  text-align: center;
  border: 2rpx solid #3366CC;
}

.change-btn text {
  font-size: 28rpx;
  color: #3366CC;
}

/* 历史问答 / 问答日历入口（与问答日历页底栏一致） */
.history-section {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 24rpx 30rpx 0;
  padding: 26rpx 28rpx;
  background-color: #FFFFFF;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.calendar-section {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 16rpx 30rpx 0;
  padding: 26rpx 28rpx;
  background-color: #FFFFFF;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.history-content,
.calendar-content {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.qa-entry-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  background-color: #E6F0FF;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.history-icon,
.calendar-icon {
  font-size: 40rpx;
  line-height: 1;
}

.history-info,
.calendar-info {
  display: flex;
  flex-direction: column;
}

.history-title,
.calendar-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}

.history-count,
.calendar-desc {
  font-size: 24rpx;
  color: #999999;
  margin-top: 6rpx;
}

.history-arrow,
.calendar-arrow {
  font-size: 36rpx;
  color: #CCCCCC;
  margin-left: 16rpx;
  flex-shrink: 0;
  line-height: 1;
}

/* 统计区域 */
.stats-section {
  display: flex;
  margin: 30rpx;
  margin-top: 24rpx;
}

.stats-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx;
  background-color: #FFFFFF;
  border-radius: 16rpx;
  margin-right: 20rpx;
}

.stats-card:last-child {
  margin-right: 0;
}

.stats-number {
  font-size: 48rpx;
  font-weight: 700;
  color: #3366CC;
}

.stats-label {
  font-size: 24rpx;
  color: #999999;
  margin-top: 8rpx;
}
