/* question-history.wxss */
/* 历史回答页面样式 */

.container {
  min-height: 100vh;
  background-color: #F5F7FA;
  display: flex;
  flex-direction: column;
}

/* 顶部标题 */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 40rpx 30rpx;
  background: linear-gradient(135deg, #3366CC 0%, #6699FF 100%);
  color: #FFFFFF;
}

.header-content {
  display: flex;
  align-items: center;
}

.header-icon {
  font-size: 56rpx;
  margin-right: 20rpx;
}

.header-text {
  display: flex;
  flex-direction: column;
}

.header-title {
  font-size: 40rpx;
  font-weight: 700;
}

.header-subtitle {
  font-size: 24rpx;
  opacity: 0.8;
  margin-top: 4rpx;
}

.filter-btn {
  padding: 12rpx 24rpx;
  background-color: rgba(255, 255, 255, 0.2);
  border-radius: 32rpx;
  font-size: 26rpx;
}

/* 筛选面板 */
.filter-panel {
  background-color: #FFFFFF;
  padding: 0 30rpx;
  max-height: 0;
  overflow: hidden;
  transition: all 0.3s ease;
}

.filter-panel.show {
  padding: 30rpx;
  max-height: 400rpx;
}

.filter-item {
  margin-bottom: 24rpx;
}

.filter-label {
  display: block;
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 12rpx;
}

.picker-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  background-color: #F5F7FA;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333333;
}

.arrow {
  font-size: 20rpx;
  color: #999999;
}

.date-range {
  display: flex;
  align-items: center;
}

.date-picker {
  flex: 1;
  padding: 20rpx 24rpx;
  background-color: #F5F7FA;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333333;
  text-align: center;
}

.date-separator {
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #999999;
}

.quick-select {
  display: flex;
  gap: 20rpx;
}

.quick-btn {
  flex: 1;
  padding: 16rpx;
  background-color: #E6F0FF;
  color: #3366CC;
  font-size: 24rpx;
  text-align: center;
  border-radius: 8rpx;
}

/* 历史回答列表 */
.answer-list {
  flex: 1;
  padding: 24rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #333333;
  font-weight: 500;
}

.empty-tip {
  font-size: 26rpx;
  color: #999999;
  margin-top: 16rpx;
}

/* 回答卡片 */
.answer-card {
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.card-date {
  margin-bottom: 20rpx;
}

.date-day {
  font-size: 26rpx;
  color: #3366CC;
  font-weight: 600;
}

.card-question {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.question-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.question-text {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.6;
  flex: 1;
}

.card-answer {
  display: flex;
  align-items: flex-start;
}

.answer-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.answer-text {
  font-size: 30rpx;
  color: #333333;
  line-height: 1.8;
  flex: 1;
}

/* 图片列表 */
.card-images {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
  gap: 16rpx;
}

.card-image-item {
  width: 150rpx;
  height: 150rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.card-image {
  width: 100%;
  height: 100%;
}

/* 宠物标签 */
.card-pet-tag {
  display: inline-flex;
  align-items: center;
  margin-top: 20rpx;
  padding: 8rpx 16rpx;
  background-color: #FFF9E6;
  border-radius: 20rpx;
}

.pet-tag-icon {
  font-size: 24rpx;
  margin-right: 8rpx;
}

.pet-tag-text {
  font-size: 22rpx;
  color: #996600;
}

/* 加载更多 */
.load-more {
  padding: 30rpx;
  text-align: center;
}

.loading {
  font-size: 26rpx;
  color: #999999;
}

.no-more {
  font-size: 26rpx;
  color: #CCCCCC;
}
