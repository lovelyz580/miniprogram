/* question-history.wxss */
/* 历史问答页面样式 */

.container {
  min-height: 100vh;
  background-color: #FFFBF5; /* 温暖奶油底色 */
  display: flex;
  flex-direction: column;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, Segoe UI, Arial, Roboto, 'PingFang SC', 'miui', 'Hiragino Sans GB', 'Microsoft Yahei', sans-serif;
}

/* 顶部标题 */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 40rpx 30rpx 30rpx;
  background: linear-gradient(135deg, #FFB74D 0%, #FF8A65 100%);
  color: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(255, 138, 101, 0.15);
}

.header-content {
  display: flex;
  align-items: center;
  flex: 1;
}

.header-icon {
  font-size: 60rpx;
  margin-right: 24rpx;
}

.header-text {
  display: flex;
  flex-direction: column;
}

.header-title {
  font-size: 42rpx;
  font-weight: 800;
  margin-bottom: 6rpx;
  letter-spacing: 0.5rpx;
}

.header-subtitle {
  font-size: 24rpx;
  opacity: 0.9;
  font-weight: 400;
}

.filter-btn {
  padding: 14rpx 28rpx;
  background-color: rgba(255, 255, 255, 0.25);
  border-radius: 50rpx;
  font-size: 26rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  transition: all 0.2s ease;
}

.filter-btn:active {
  transform: scale(0.98);
}

/* 筛选面板 */
.filter-panel {
  background-color: #FFFFFF;
  padding: 0 30rpx;
  max-height: 0;
  overflow: hidden;
  transition: all 0.3s ease;
  box-shadow: 0 8rpx 24rpx rgba(180, 160, 140, 0.08);
}

.filter-panel.show {
  padding: 36rpx 30rpx;
  max-height: 500rpx;
}

.filter-item {
  margin-bottom: 28rpx;
}

.filter-label {
  display: block;
  font-size: 28rpx;
  color: #5C4A42;
  margin-bottom: 16rpx;
  font-weight: 700;
}

.picker-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  background-color: #FFFBF5;
  border-radius: 20rpx;
  font-size: 30rpx;
  color: #4A3E38;
  border: 2rpx solid #FFF0E5;
  font-weight: 600;
}

.arrow {
  font-size: 20rpx;
  color: #A89F9A;
}

.date-range {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.date-picker {
  flex: 1;
  padding: 24rpx 28rpx;
  background-color: #FFFBF5;
  border-radius: 20rpx;
  font-size: 28rpx;
  color: #4A3E38;
  text-align: center;
  border: 2rpx solid #FFF0E5;
  font-weight: 600;
}

.date-separator {
  font-size: 28rpx;
  color: #A89F9A;
  font-weight: 500;
}

.quick-select {
  display: flex;
  gap: 16rpx;
}

.quick-btn {
  flex: 1;
  padding: 20rpx;
  background: linear-gradient(135deg, #FFF0E5 0%, #FFE6D6 100%);
  color: #FF8A65;
  font-size: 26rpx;
  text-align: center;
  border-radius: 20rpx;
  font-weight: 700;
  transition: all 0.2s ease;
}

.quick-btn:active {
  transform: scale(0.98);
  background: linear-gradient(135deg, #FFE6D6 0%, #FFDAB9 100%);
}

/* 历史回答列表 */
.answer-list {
  flex: 1;
  padding: 24rpx 30rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
  opacity: 0.8;
}

.empty-text {
  font-size: 34rpx;
  color: #5C4A42;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.empty-tip {
  font-size: 28rpx;
  color: #A89F9A;
  font-weight: 500;
}

/* 回答卡片 */
.answer-card {
  background-color: #FFFFFF;
  border-radius: 32rpx;
  padding: 36rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(180, 160, 140, 0.1);
  transition: all 0.2s ease;
  position: relative;
  overflow: hidden;
}

.answer-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  background: linear-gradient(90deg, #FFB74D 0%, #FF8A65 100%);
}

.answer-card:active {
  transform: scale(0.99);
}

.card-date {
  margin-bottom: 24rpx;
}

.date-day {
  font-size: 26rpx;
  color: #FF8A65;
  font-weight: 700;
  background-color: #FFF0E5;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  display: inline-block;
}

.card-question {
  display: flex;
  align-items: flex-start;
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx dashed #F0E8E1;
}

.question-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.question-text {
  font-size: 30rpx;
  color: #8C7A70;
  line-height: 1.6;
  flex: 1;
  font-weight: 600;
}

.card-answer {
  display: flex;
  align-items: flex-start;
}

.answer-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.answer-text {
  font-size: 32rpx;
  color: #4A3E38;
  line-height: 1.8;
  flex: 1;
  font-weight: 500;
}

/* 图片列表 */
.card-images {
  display: flex;
  flex-wrap: wrap;
  margin-top: 24rpx;
  gap: 16rpx;
}

.card-image-item {
  width: 180rpx;
  height: 180rpx;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(180, 160, 140, 0.1);
}

.card-image {
  width: 100%;
  height: 100%;
}

/* 宠物标签 */
.card-pet-tag {
  display: inline-flex;
  align-items: center;
  margin-top: 24rpx;
  padding: 10rpx 20rpx;
  background: linear-gradient(135deg, #FFF9E6 0%, #FFF3D4 100%);
  border-radius: 30rpx;
  border: 2rpx solid #FFE6B3;
}

.pet-tag-icon {
  font-size: 26rpx;
  margin-right: 10rpx;
}

.pet-tag-text {
  font-size: 24rpx;
  color: #8C6A30;
  font-weight: 700;
}

/* 加载更多 */
.load-more {
  padding: 40rpx;
  text-align: center;
}

.loading {
  font-size: 28rpx;
  color: #A89F9A;
  font-weight: 500;
}

.no-more {
  font-size: 28rpx;
  color: #D1C9C4;
  font-weight: 500;
}
