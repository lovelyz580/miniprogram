/* diary.wxss */

/* 页面容器 */
.container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background-color: #FFFBF5;
  padding-bottom: 140rpx;
}

/* 顶部导航栏 */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background-color: #FFFFFF;
  border-bottom: none;
  box-shadow: 0 4rpx 16rpx rgba(180, 160, 140, 0.06);
}

.nav-cancel {
  font-size: 28rpx;
  color: #666666;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333333;
}

.nav-publish {
  font-size: 28rpx;
  color: #BDB3AC;
  padding: 10rpx 24rpx;
  border-radius: 32rpx;
  background-color: #FFF0E5;
}

.nav-publish.active {
  color: #FFFFFF;
  background: linear-gradient(135deg, #FFB74D 0%, #FF8A65 100%);
  box-shadow: 0 4rpx 12rpx rgba(255, 138, 101, 0.3);
}

/* 日期选择 */
.date-selector {
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
  background-color: #FFFFFF;
  margin: 24rpx 30rpx 0;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(180, 160, 140, 0.08);
}

.date-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.date-text {
  flex: 1;
  font-size: 30rpx;
  color: #333333;
}

.date-arrow {
  font-size: 32rpx;
  color: #999999;
}

/* 宠物选择 */
.pet-selector {
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
  background-color: #FFFFFF;
  margin: 24rpx 30rpx 0;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(180, 160, 140, 0.08);
}

.pet-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.pet-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  margin-right: 16rpx;
}

.pet-name {
  flex: 1;
  font-size: 30rpx;
  color: #333333;
}

.pet-arrow {
  font-size: 32rpx;
  color: #999999;
}

/* 富文本编辑器区域 */
.editor-section {
  margin: 24rpx 30rpx;
  background-color: #FFFFFF;
  padding: 30rpx;
  position: relative;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(180, 160, 140, 0.08);
}

.content-editor {
  width: 100%;
  min-height: 400rpx;
  font-size: 32rpx;
  line-height: 1.8;
  color: #333333;
}

.content-editor.placeholder {
  color: #CCCCCC;
}

/* 格式工具栏 */
.format-toolbar {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-top: 1rpx solid #EEEEEE;
  margin-top: 20rpx;
}

.format-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  background-color: #FFFBF5;
  margin-right: 16rpx;
  font-size: 28rpx;
  color: #8C7A70;
}

.format-btn.active {
  background-color: #FFF0E5;
  color: #FF8A65;
  font-weight: 600;
}

.format-separator {
  width: 1rpx;
  height: 40rpx;
  background-color: #EEEEEE;
  margin: 0 16rpx;
}

/* 字数统计 */
.word-count {
  position: absolute;
  bottom: 20rpx;
  right: 30rpx;
  font-size: 24rpx;
  color: #999999;
}

/* 媒体区域 */
.media-section {
  margin: 24rpx 30rpx;
  background-color: #FFFFFF;
  padding: 30rpx;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(180, 160, 140, 0.08);
}

.media-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}

.media-tip {
  font-size: 24rpx;
  color: #999999;
}

.media-grid {
  display: flex;
  flex-wrap: wrap;
}

.media-item {
  width: 210rpx;
  height: 210rpx;
  margin-right: 20rpx;
  margin-bottom: 20rpx;
  border-radius: 12rpx;
  overflow: hidden;
  position: relative;
}

.media-preview {
  width: 100%;
  height: 100%;
}

.media-delete {
  position: absolute;
  top: 0;
  right: 0;
  width: 44rpx;
  height: 44rpx;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 32rpx;
}

.add-media-btn {
  width: 210rpx;
  height: 210rpx;
  background-color: #FFFBF5;
  border: 2rpx dashed #FFDAB9;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}

.add-icon {
  font-size: 64rpx;
  color: #999999;
  line-height: 1;
}

.add-text {
  font-size: 24rpx;
  color: #999999;
  margin-top: 8rpx;
}

/* 标签区域 */
.tag-section {
  margin: 24rpx 30rpx;
  background-color: #FFFFFF;
  padding: 30rpx;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(180, 160, 140, 0.08);
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
}

.tag-item {
  padding: 12rpx 24rpx;
  background-color: #FFFBF5;
  border-radius: 32rpx;
  margin-right: 16rpx;
  margin-bottom: 16rpx;
  font-size: 26rpx;
  color: #8C7A70;
  border: 2rpx solid #FFF0E5;
}

.tag-item.active {
  background-color: #FFF0E5;
  color: #FF8A65;
  border-color: #FF8A65;
  font-weight: 600;
}

/* 位置信息 */
.location-section {
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
  background-color: #FFFFFF;
  margin: 24rpx 30rpx;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(180, 160, 140, 0.08);
}

.location-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.location-text {
  flex: 1;
  font-size: 30rpx;
  color: #333333;
}

.location-arrow {
  font-size: 32rpx;
  color: #999999;
}

.location-clear {
  font-size: 32rpx;
  color: #999999;
  padding: 10rpx;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 20rpx 60rpx;
  background-color: #FFFFFF;
  border-top: 1rpx solid #EEEEEE;
}

.action-item {
  display: flex;
  align-items: center;
}

.action-icon {
  font-size: 36rpx;
  margin-right: 8rpx;
}

.action-text {
  font-size: 28rpx;
  color: #666666;
}

/* 弹窗样式 */
.picker-modal,
.pet-picker-modal,
.media-picker-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  visibility: hidden;
  opacity: 0;
  transition: all 0.3s ease;
}

.picker-modal.show,
.pet-picker-modal.show,
.media-picker-modal.show {
  visibility: visible;
  opacity: 1;
}

.picker-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
}

.picker-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #FFFFFF;
  border-radius: 24rpx 24rpx 0 0;
  padding-bottom: env(safe-area-inset-bottom);
}

.picker-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  border-bottom: 1rpx solid #EEEEEE;
  font-size: 30rpx;
  color: #FF8A65;
}

.picker-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

/* 日期选择器 */
.date-picker {
  height: 400rpx;
}

.picker-item {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

/* 宠物选择列表 */
.pet-picker-content {
  max-height: 70vh;
}

.pet-list {
  padding: 20rpx 30rpx;
  max-height: 500rpx;
  overflow-y: auto;
}

.pet-option {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-radius: 24rpx;
  margin-bottom: 16rpx;
  background-color: #FFFBF5;
  border: 2rpx solid transparent;
}

.pet-option.active {
  background-color: #FFF9F5;
  border: 2rpx solid #FF8A65;
}

.pet-option-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.pet-option-name {
  flex: 1;
  font-size: 30rpx;
  color: #333333;
}

.pet-option-check {
  font-size: 32rpx;
  color: #FF8A65;
}

.pet-picker-footer {
  padding: 30rpx;
  text-align: center;
  border-top: 1rpx solid #EEEEEE;
  color: #FF8A65;
  font-size: 30rpx;
  font-weight: 600;
}

/* 媒体选择弹窗 */
.media-options {
  display: flex;
  padding: 40rpx 60rpx;
}

.media-option {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx;
  background-color: #FFFBF5;
  border-radius: 24rpx;
  margin: 0 20rpx;
}

.media-option-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.media-option-text {
  font-size: 28rpx;
  color: #666666;
}

.media-picker-cancel {
  padding: 30rpx;
  text-align: center;
  color: #999999;
  font-size: 30rpx;
  border-top: 1rpx solid #EEEEEE;
}
